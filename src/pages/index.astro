---
import { Image } from 'astro:assets';
import photoOne from '../assets/housefront.avif';
// Import your other photos here...
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Real Estate Photography</title>
  </head>
  <body class="bg-gray-50 text-gray-900 p-4 md:p-8">
    <h1 class="text-4xl font-bold mb-8 text-center">Portfolio</h1>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <Image src={photoOne} alt="Modern home exterior" class="w-full h-auto rounded-lg shadow-md object-cover" />
      </div>
  </body>
</html>
