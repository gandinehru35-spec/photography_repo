---
import '../styles/global.css';
import { Image } from 'astro:assets';

// 1. AUTOMATED IMPORT
const imageFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{avif,webp,svg}', { eager: true });
const allImages = Object.values(imageFiles).map(file => file.default);

// 2. HERO IMAGE
const heroBg = allImages.find(img => img.src.includes('housefront')) || allImages[0];

// 3. GALLERY & CATEGORY TAGGING
// We map through the images and automatically tag them based on their filename.
// "DJI" files become aerials, everything else defaults to interiors.
const galleryItems = allImages.filter(img => img !== heroBg).map((img) => {
  return {
    image: img,
    category: img.src.includes('DJI') ? 'aerial' : 'interior'
  };
});
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-[#FAFAFA]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Estate Visuals | Editorial</title>
  </head>
  <body class="text-[#1A1A1A] font-sans antialiased overflow-x-hidden selection:bg-slate-900 selection:text-white">
    
    <nav class="fixed top-0 w-full z-40 bg-white/80 backdrop-blur-md border-b border-gray-100 transition-all duration-300 py-4">
      <div class="px-6 md:px-12 flex justify-between items-center max-w-screen-2xl mx-auto">
        <a href="#" class="flex items-center gap-3">
          <div class="h-8 w-8 bg-[#1A1A1A] rounded-sm flex items-center justify-center text-[10px] text-white tracking-widest font-bold">EV</div>
          <span class="font-bold text-xl tracking-tight uppercase">Estate Visuals</span>
        </a>
        <div class="space-x-8 text-sm font-medium tracking-wide hidden md:block">
          <a href="#portfolio" class="hover:text-gray-500 transition duration-300">PORTFOLIO</a>
          <a href="#book" class="text-slate-900 border-b border-slate-900 pb-1 hover:text-gray-500 hover:border-gray-500 transition duration-300">BOOK SHOOT</a>
        </div>
      </div>
    </nav>

    <header class="relative pt-32 pb-20 md:pt-48 md:pb-32 px-6 md:px-12 max-w-screen-2xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="max-w-xl">
          <h1 class="text-5xl md:text-7xl font-extrabold tracking-tighter mb-6 leading-[1.1]">
            Capturing <br/> Space & Light.
          </h1>
          <p class="text-lg text-gray-500 mb-10 leading-relaxed">
            A curated portfolio of high-end residential interiors, dynamic aerial perspectives, and architectural twilight photography across Southern Ontario.
          </p>
          <a href="#portfolio" class="inline-flex items-center gap-2 text-sm font-bold tracking-widest uppercase hover:text-gray-500 transition-colors">
            Explore Portfolio
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        </div>
        <div class="relative w-full aspect-[4/3] rounded-2xl overflow-hidden shadow-2xl">
          <Image src={heroBg} alt="Featured Property" class="w-full h-full object-cover" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </header>

    <main id="portfolio" class="px-6 md:px-12 py-12 max-w-screen-2xl mx-auto border-t border-gray-200">
      
      <div class="flex flex-wrap items-center justify-between mb-12 gap-6">
        <h2 class="text-3xl font-bold tracking-tight">Selected Works</h2>
        <div class="flex gap-4" id="filter-controls">
          <button class="filter-btn active text-sm font-semibold tracking-wide border-b-2 border-[#1A1A1A] pb-1" data-filter="all">All</button>
          <button class="filter-btn text-sm font-semibold tracking-wide text-gray-400 hover:text-[#1A1A1A] pb-1 transition" data-filter="interior">Interiors</button>
          <button class="filter-btn text-sm font-semibold tracking-wide text-gray-400 hover:text-[#1A1A1A] pb-1 transition" data-filter="aerial">Aerials</button>
        </div>
      </div>

      <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6" id="gallery-grid">
        {galleryItems.map((item, index) => (
          <div 
            class={`gallery-item group relative overflow-hidden bg-gray-100 rounded-xl cursor-zoom-in lightbox-trigger break-inside-avoid ${index >= 9 ? 'hidden extra-image' : ''}`}
            data-category={item.category}
            data-highres={item.image.src}
          >
            <Image 
              src={item.image} 
              alt={`Portfolio Image`} 
              loading={index < 6 ? "eager" : "lazy"}
              class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-[1.03]" 
            />
            <div class="absolute inset-0 bg-white/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 backdrop-blur-[2px]"></div>
          </div>
        ))}
      </div>

      {galleryItems.length > 9 && (
        <div class="flex justify-center mt-16" id="load-more-container">
          <button id="load-more-btn" class="bg-white border border-gray-300 text-gray-700 hover:bg-gray-50 px-10 py-4 rounded-full tracking-widest uppercase text-xs font-bold transition-all shadow-sm hover:shadow-md">
            Load More Images
          </button>
        </div>
      )}
    </main>

    <section id="book" class="py-24 bg-white mt-12">
      <div class="max-w-4xl mx-auto px-6 text-center">
        <h2 class="text-4xl font-extrabold mb-4">Secure Your Session</h2>
        <p class="text-gray-500 mb-12 max-w-xl mx-auto">Select a photography package below. Your time slot will be confirmed upon successful payment integration.</p>
        
        <div class="bg-gray-50 border border-gray-200 rounded-2xl p-8 md:p-12 min-h-[500px] flex items-center justify-center shadow-inner">
          <div class="text-gray-400 border border-dashed border-gray-300 p-8 rounded-xl w-full bg-white">
            <p class="font-mono text-sm">[ CAL.COM / STRIPE EMBED CODE GOES HERE ]</p>
          </div>
        </div>
      </div>
    </section>

    <footer class="border-t border-gray-200 py-12 text-center text-gray-400 text-sm bg-[#FAFAFA]">
      <p>&copy; 2026 Estate Visuals. All rights reserved.</p>
    </footer>

    <div id="lightbox-modal" class="fixed inset-0 z-50 bg-white/95 hidden items-center justify-center backdrop-blur-xl opacity-0 transition-opacity duration-300">
      <button id="lightbox-close" class="absolute top-6 right-6 text-gray-500 hover:text-black transition p-2 bg-gray-100 rounded-full">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      <img id="lightbox-image" src="" alt="Full Resolution" class="max-w-[95vw] max-h-[90vh] object-contain shadow-2xl rounded-lg" />
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        
        // --- 1. LIVE CATEGORY FILTERING ---
        const filterBtns = document.querySelectorAll('.filter-btn');
        const galleryItems = document.querySelectorAll('.gallery-item');
        const loadMoreContainer = document.getElementById('load-more-container');
        let currentFilter = 'all';

        filterBtns.forEach(btn => {
          btn.addEventListener('click', (e) => {
            // Update active button styling
            filterBtns.forEach(b => {
              b.classList.remove('active', 'border-b-2', 'border-[#1A1A1A]', 'text-[#1A1A1A]');
              b.classList.add('text-gray-400');
            });
            const target = e.target as HTMLElement;
            target.classList.add('active', 'border-b-2', 'border-[#1A1A1A]', 'text-[#1A1A1A]');
            target.classList.remove('text-gray-400');

            currentFilter = target.getAttribute('data-filter') || 'all';

            // Filter logic
            galleryItems.forEach(item => {
              const itemCategory = item.getAttribute('data-category');
              const isExtra = item.classList.contains('extra-image');
              
              if (currentFilter === 'all' || currentFilter === itemCategory) {
                // Only show if it's not hidden by the "Load More" logic
                if (!isExtra) item.classList.remove('hidden');
              } else {
                item.classList.add('hidden');
              }
            });

            // Hide the load more button if we are filtering
            if (loadMoreContainer) {
              loadMoreContainer.style.display = currentFilter === 'all' ? 'flex' : 'none';
            }
          });
        });

        // --- 2. LOAD MORE FUNCTIONALITY ---
        const loadMoreBtn = document.getElementById('load-more-btn');
        if (loadMoreBtn) {
          loadMoreBtn.addEventListener('click', () => {
            galleryItems.forEach(item => {
              item.classList.remove('extra-image');
              // Only reveal if it matches the current active filter
              const itemCategory = item.getAttribute('data-category');
              if (currentFilter === 'all' || currentFilter === itemCategory) {
                item.classList.remove('hidden');
              }
            });
            if (loadMoreContainer) loadMoreContainer.remove();
          });
        }

        // --- 3. LIGHTBOX FUNCTIONALITY ---
        const modal = document.getElementById('lightbox-modal');
        const modalImage = document.getElementById('lightbox-image');
        const closeBtn = document.getElementById('lightbox-close');
        
        galleryItems.forEach(trigger => {
          trigger.addEventListener('click', () => {
            const highResSource = trigger.getAttribute('data-highres');
            if (modalImage && modal && highResSource) {
              modalImage.setAttribute('src', highResSource);
              modal.classList.remove('hidden');
              modal.classList.add('flex');
              setTimeout(() => modal.classList.remove('opacity-0'), 10);
              document.body.style.overflow = 'hidden';
            }
          });
        });

        const closeModal = () => {
          if (modal) {
            modal.classList.add('opacity-0');
            setTimeout(() => {
              modal.classList.add('hidden');
              modal.classList.remove('flex');
              if (modalImage) modalImage.setAttribute('src', '');
            }, 300);
            document.body.style.overflow = 'auto';
          }
        };

        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (modal) {
          modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
          });
        }
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeModal();
        });
      });
    </script>
  </body>
</html>