---
import '../styles/global.css';
import { Image } from 'astro:assets';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/*.{avif,AVIF,webp,WEBP,jpg,JPG,jpeg,JPEG,png,PNG,svg,SVG}',
  { eager: true }
);

const allItems = Object.entries(imageFiles).map(([path, file]) => {
  const img = file.default;
  const filename = path.split('/').pop() || '';

  return {
    image: img,
    filename,
    category: filename.toUpperCase().includes('DJI') ? 'aerial' : 'interior'
  };
});

const heroItem = allItems.find((item) =>
  item.filename.toLowerCase().includes('housefront')
);

const heroBg = heroItem ? heroItem.image : allItems[0]?.image;
const galleryItems = allItems.filter((item) => item.image !== heroBg);
const initialGallery = galleryItems.slice(0, 12);
const extendedGallery = galleryItems.slice(12);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>J Arts 360 View | Premium Real Estate Media</title>
    <meta
      name="description"
      content="Premium real estate photography, video, drone media, and 3D tours for listings that need to stand out."
    />
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <nav class="site-nav">
      <div class="nav-inner">
        <a href="/" class="brand-mark" aria-label="J Arts 360 View home">
          <img
            src="/logo.png"
            alt="J Arts 360 View Logo"
            class="brand-logo"
          />
          <div class="brand-copy">
            <span class="brand-name">J Arts 360 View</span>
            <span class="brand-tagline">Real Estate Media</span>
          </div>
        </a>

        <div class="nav-links">
          <a href="#services">Services</a>
          <a href="#portfolio">Portfolio</a>
          <a href="#testimonials">Reviews</a>
          <a href="#book" class="nav-cta">Book Now</a>
        </div>
      </div>
    </nav>

    <main id="main-content">
      <header class="hero section-shell">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Premium Property Marketing</p>

            <h1 class="section-title hero-title">
