---
import '../styles/global.css';
import { Image } from 'astro:assets';

const portalApiBase = (import.meta.env.PUBLIC_PORTAL_API_BASE || 'https://jarts-client-portal.aneeqpatelcuts.workers.dev').replace(/\/$/, '');
const calLink = import.meta.env.PUBLIC_CAL_LINK || 'jarts/30min';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/*.{avif,AVIF,webp,WEBP,jpg,JPG,jpeg,JPEG,png,PNG,svg,SVG}',
  { eager: true }
);

const allItems = Object.entries(imageFiles).map(([path, file]) => {
  const img = file.default;
  const filename = path.split('/').pop() || '';
  return {
    image: img,
    filename,
    category: filename.toUpperCase().includes('DJI') ? 'aerial' : 'interior'
  };
});

// Replace this filename with your preferred hero background image.
const heroPrimary = allItems.find((item) => item.filename.toLowerCase() === 'jar05747.avif') ?? allItems[0];
const heroFileSet = new Set(heroPrimary ? [heroPrimary.filename.toLowerCase()] : []);

// Replace these 2 filenames with the interior images you want shown first in portfolio.
const preferredInteriorFilenames = ['JAR05750.avif', 'JAR05753.avif'];
const preferredInteriorItems = preferredInteriorFilenames
  .map((targetName) => allItems.find((item) => item.filename.toLowerCase() === targetName.toLowerCase()))
  .filter(Boolean)
  .map((item) => ({ ...item, category: 'interior' }));

const remainingGalleryItems = allItems.filter(
  (item) => !heroFileSet.has(item.filename.toLowerCase()) && !preferredInteriorItems.find((p) => p.filename === item.filename)
);
const initialGallery = preferredInteriorItems.slice(0, 2);
const extendedGallery = remainingGalleryItems;

const portalBaseUrl = 'https://jarts-client-portal.aneeqpatelcuts.workers.dev';
const portalLoginUrl = `${portalBaseUrl}/login`;
const portalSignupUrl = `${portalBaseUrl}/signup`;

const tours = [
  {
    title: "Lion's Head iGuide Tour",
    location: "595 Stokes Bay Rd, Lion's Head, ON",
    platform: 'iGuide',
    url: 'https://youriguide.com/595_stokes_bay_rd_lion_s_head_on'
  },
  {
    title: 'Port Elgin iGuide Tour',
    location: '912 Parkwood Dr, Port Elgin, ON',
    platform: 'iGuide',
    url: 'https://youriguide.com/912_parkwood_dr_port_elgin_on'
  },
  {
    title: 'Waterloo iGuide Tour',
    location: '361 Red Osier Rd, Waterloo, ON',
    platform: 'iGuide',
    url: 'https://youriguide.com/7rqlg_361_red_osier_rd_waterloo_on'
  },
  {
    title: 'Matterport Showcase 01',
    location: 'Interactive 3D walkthrough',
    platform: 'Matterport',
    url: 'https://my.matterport.com/show/?m=p38JCFUsEs1'
  },
  {
    title: 'Matterport Showcase 02',
    location: 'Interactive 3D walkthrough',
    platform: 'Matterport',
    url: 'https://my.matterport.com/show/?m=6L2pqyF5Jow'
  },
  {
    title: 'Matterport Showcase 03',
    location: 'Interactive 3D walkthrough',
    platform: 'Matterport',
    url: 'https://my.matterport.com/show/?m=FCeytGXXvyB'
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>J Arts 360 View | Real Estate Photography, Video &amp; 3D Tours</title>
    <meta
      name="description"
      content="Real estate photography, drone coverage, cinematic video, and 3D tours for listings across Guelph, GTA, and surrounding areas."
    />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="mobile-overlay" id="mobile-overlay" aria-hidden="true"></div>

    <nav class="site-nav" id="site-nav">
      <div class="nav-inner">
        <a href="#hero" class="brand-mark cinematic-brand" aria-label="J Arts 360 View home">
          <span class="brand-emblem" aria-hidden="true">
            <span class="brand-emblem-core">J</span>
            <span class="brand-emblem-shine"></span>
          </span>
          <span class="brand-copy">
            <span class="brand-kicker">Real Estate Media</span>
            <span class="brand-name-row">
              <span class="brand-name-main">J Arts</span>
              <span class="brand-name-accent">360 View</span>
            </span>
            <span class="brand-tagline">Photography · Drone · Video · 3D Tours</span>
          </span>
        </a>

        <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Open navigation menu" aria-expanded="false" aria-controls="nav-links" type="button">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>

        <div class="nav-links" id="nav-links" role="navigation" aria-label="Main navigation">
          <a href="#services" class="nav-link">Services</a>
          <a href="#tours" class="nav-link">3D Tours</a>
          <a href="#portfolio" class="nav-link">Portfolio</a>
          <a href="#testimonials" class="nav-link">Reviews</a>
          <a href={portalLoginUrl} target="_blank" rel="noopener noreferrer" class="nav-link nav-portal-link">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            Client Login
          </a>
          <a href="#book" class="nav-cta">Build &amp; Book</a>
        </div>
      </div>
    </nav>

    <main id="main-content">
      <header class="hero" id="hero">
        <div class="hero-bg-wrap">
          {heroPrimary && <Image src={heroPrimary.image} alt="Featured real estate photography" class="hero-bg-image" loading="eager" />}
          <div class="hero-bg-overlay"></div>
        </div>

        <div class="section-shell hero-shell hero-shell-center">
          <div class="hero-content-block hero-content-center glass-card">
            <p class="eyebrow">Guelph · GTA · Surrounding Areas</p>
            <p class="section-copy hero-text">
              Real estate photography, drone coverage, cinematic video, and immersive 3D tours for agents, builders, and property owners who want a stronger marketing presentation.
            </p>
            <div class="hero-actions hero-actions-center">
              <a href="#services" class="primary-btn btn-ripple">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Build a Package
              </a>
              <a href="#portfolio" class="secondary-btn">View Portfolio</a>
            </div>
          </div>
        </div>
      </header>

      <section class="trust-strip" aria-label="What is included">
        <div class="section-shell trust-grid glass-card">
          <div>
            <p class="eyebrow">Clear Coverage</p>
            <p class="section-copy">Photography, drone, video, and 3D tours can be combined into one package based on the property and listing goals.</p>
          </div>
          <div>
            <p class="eyebrow">Flexible Booking</p>
            <p class="section-copy">Use the package builder to estimate the scope first, then save the request before opening the calendar.</p>
          </div>
          <div>
            <p class="eyebrow">Client Access</p>
            <p class="section-copy">Returning clients can log in to the portal to review booking-related information and account details.</p>
          </div>
        </div>
      </section>

      <section id="services" class="section-pad">
        <div class="section-shell">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Services</p>
              <h2 class="section-title section-title-medium">Build the right package for the property.</h2>
            </div>
            <p class="section-copy section-heading-copy">
              Start with a service, then adjust for square footage, property type, turnaround, and add-ons. These are estimate ranges for now and can be finalized later.
            </p>
          </div>

          <div class="services-grid services-grid-5">

            <article class="service-card reveal-item" data-service-card data-service-key="photo" data-service-name="Listing Photography" data-base-price="120">
              <div class="service-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
              </div>
              <h3>Listing Photography</h3>
              <p class="service-price">From $120 <span>+ HST</span></p>
              <p>Interior and exterior photography prepared for listing presentation.</p>
              <button class="toggle-service-btn" data-toggle-service type="button">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                <span class="btn-text">Add to Package</span>
              </button>
            </article>

            <article class="service-card reveal-item" data-service-card data-service-key="video" data-service-name="Cinematic Video" data-base-price="150">
              <div class="service-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="2" y="7" width="15" height="10" rx="2"/><path d="m17 9 5-2v10l-5-2V9z"/></svg>
              </div>
              <h3>Cinematic Video</h3>
              <p class="service-price">From $150 <span>+ HST</span></p>
              <p>Walkthrough-style video designed to show flow, finishes, and space.</p>
              <button class="toggle-service-btn" data-toggle-service type="button">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                <span class="btn-text">Add to Package</span>
              </button>
            </article>

            <article class="service-card reveal-item" data-service-card data-service-key="drone" data-service-name="Drone Aerial" data-base-price="99">
              <div class="service-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><ellipse cx="12" cy="12" rx="2.5" ry="2.5"/><path d="M5 5h3v3H5zM16 5h3v3h-3zM5 16h3v3H5zM16 16h3v3h-3z"/><path d="M7 7 9.5 9.5M14.5 9.5 17 7M7 17l2.5-2.5M14.5 14.5 17 17"/></svg>
              </div>
              <h3>Drone Aerial</h3>
              <p class="service-price">From $99 <span>+ HST</span></p>
              <p>Aerial coverage to show property context, lot position, and surroundings.</p>
              <button class="toggle-service-btn" data-toggle-service type="button">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                <span class="btn-text">Add to Package</span>
              </button>
            </article>

            <article class="service-card reveal-item" data-service-card data-service-key="tour" data-service-name="3D Virtual Tours" data-base-price="200">
              <div class="service-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
              </div>
              <h3>3D Virtual Tours</h3>
              <p class="service-price">From $200 <span>+ HST</span></p>
              <p>Interactive tours for buyers who want to explore layout and room flow remotely.</p>
              <button class="toggle-service-btn" data-toggle-service type="button">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                <span class="btn-text">Add to Package</span>
              </button>
            </article>

            <article class="service-card reveal-item" data-service-card data-service-key="sign" data-service-name="Signboard Placement" data-base-price="50">
              <div class="service-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="7" width="18" height="8" rx="1.5"/><path d="M12 15v6M12 3v4"/></svg>
              </div>
              <h3>Signboard Placement</h3>
              <p class="service-price">From $50 <span>+ HST</span></p>
              <p>Installation and removal support for standard real estate signage.</p>
              <button class="toggle-service-btn" data-toggle-service type="button">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                <span class="btn-text">Add to Package</span>
              </button>
            </article>
                    </div>
        </div>
      </section>

      <div id="package-builder-bar" class="package-builder-bar hidden" role="status" aria-live="polite">
        <div class="package-info">
          <span class="package-count">0 Services Selected</span>
          <span class="package-total">Estimated: $0 + HST</span>
        </div>
        <button id="package-checkout-btn" class="primary-btn btn-ripple package-checkout-btn" type="button">Review &amp; Book</button>
      </div>

      <section id="tours" class="section-pad tours-section">
        <div class="section-shell">
          <div class="section-heading">
            <div>
              <p class="eyebrow">3D Tours</p>
              <h2 class="section-title section-title-medium">Interactive walkthroughs for remote viewing.</h2>
            </div>
            <p class="section-copy section-heading-copy">
              These examples show the kind of 3D tour experience available for listings that benefit from stronger remote access and layout visibility.
            </p>
          </div>

          <div class="tours-grid">
            {tours.map((tour) => (
              <article class="tour-card glass-card">
                <div class="tour-topline">
                  <span class="tour-platform">{tour.platform}</span>
                  <span class="tour-chip">Interactive Tour</span>
                </div>
                <h3>{tour.title}</h3>
                <p>{tour.location}</p>
                <a href={tour.url} target="_blank" rel="noopener noreferrer" class="secondary-btn">Open Tour</a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="portfolio" class="section-pad portfolio-section">
        <div class="section-shell">
          <div class="section-heading portfolio-head">
            <div>
              <p class="eyebrow">Portfolio</p>
              <h2 class="section-title section-title-medium">Selected property visuals.</h2>
            </div>
            <div class="filter-row" id="filter-controls" role="group" aria-label="Filter by category">
              <button class="filter-btn" data-filter="all" type="button">All</button>
              <button class="filter-btn active" data-filter="interior" type="button">Interiors</button>
              <button class="filter-btn" data-filter="aerial" type="button">Aerials</button>
            </div>
          </div>

          <div class="gallery-grid" id="gallery-grid">
            {initialGallery.map((item) => (
              <button class="gallery-item lightbox-trigger" data-category={item.category} data-highres={item.image.src} aria-label={`View full size ${item.category} photo`} type="button">
                <Image src={item.image} alt={`J Arts 360 View ${item.category} property photo`} class="gallery-image" loading="lazy" />
                <span class="gallery-overlay" aria-hidden="true">View</span>
              </button>
            ))}
            {extendedGallery.map((item) => (
              <button class="gallery-item lightbox-trigger extra-image hidden" data-category={item.category} data-highres={item.image.src} aria-label={`View full size ${item.category} photo`} type="button">
                <Image src={item.image} alt={`J Arts 360 View ${item.category} property photo`} class="gallery-image" loading="lazy" />
                <span class="gallery-overlay" aria-hidden="true">View</span>
              </button>
            ))}
          </div>

          {extendedGallery.length > 0 && (
            <div class="load-more-wrap" id="load-more-container">
              <button id="load-more-btn" class="secondary-btn" type="button">Load More Photos</button>
            </div>
          )}
        </div>
      </section>

      <section id="testimonials" class="section-pad">
        <div class="section-shell">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Client Reviews</p>
              <h2 class="section-title section-title-medium">Feedback from past clients.</h2>
            </div>
            <div class="review-summary">
              <div class="review-score">5.0</div>
              <div>
                <div class="review-stars" aria-label="5 out of 5 stars">★★★★★</div>
                <p class="review-count">Based on verified client reviews</p>
              </div>
            </div>
          </div>

          <div class="reviews-grid">
            <article class="quote-card reveal-item">
              <div class="quote-stars" aria-label="5 stars">★★★★★</div>
              <p>Beautifully clicked the pictures. Professional, prompt and friendly service.</p>
              <footer><strong>Monika Bansal</strong></footer>
            </article>
            <article class="quote-card reveal-item">
              <div class="quote-stars" aria-label="5 stars">★★★★★</div>
              <p>Photos they produced were absolutely stunning. Commitment to customer satisfaction is truly impressive.</p>
              <footer><strong>Sushaant Dhamijaa</strong></footer>
            </article>
            <article class="quote-card reveal-item">
              <div class="quote-stars" aria-label="5 stars">★★★★★</div>
              <p>Consistently delivers outstanding results. Communication and scheduling support have been excellent.</p>
              <footer><strong>Benson Crew</strong></footer>
            </article>
          </div>
        </div>
      </section>

      <section id="book" class="section-pad booking-section">
        <div class="section-shell booking-layout">
          <div class="booking-info">
            <p class="eyebrow">Book a Shoot</p>
            <h2 class="section-title section-title-medium">Configure your package, then open the calendar.</h2>
            <p class="section-copy booking-copy">
              Select services above, fill in your details, configure property options, and hit <em>Save Request &amp; Open Calendar</em>. Everything is saved to the portal before the calendar opens.
            </p>
            <div class="contact-stack">
              <a href="tel:6477103982" class="contact-item contact-link"><span class="contact-badge">T</span><span>647 710 3982</span></a>
              <a href="mailto:jarts360view@gmail.com" class="contact-item contact-link"><span class="contact-badge">E</span><span>jarts360view@gmail.com</span></a>
              <div class="contact-item"><span class="contact-badge">HQ</span><span>63 Candlewood Drive, Guelph</span></div>
            </div>
            <div class="portal-cta-strip">
              <p class="portal-cta-label">Returning client?</p>
              <div class="portal-cta-actions">
                <a href={portalLoginUrl} target="_blank" rel="noopener noreferrer" class="portal-pill-btn">Client Login</a>
                <a href={portalSignupUrl} target="_blank" rel="noopener noreferrer" class="portal-pill-btn portal-pill-outline">Create Account</a>
              </div>
            </div>
          </div>

          <div class="booking-panel glass-card" id="booking-panel-wrap">
            <div id="booking-placeholder-state" class="booking-placeholder">
              <div class="booking-icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              </div>
              <h3>No package selected yet</h3>
              <p>Select one or more services above. Your selections, pricing, address, and notes will be saved before the calendar opens.</p>
              <div class="booking-actions">
                <a href="#services" class="primary-btn btn-ripple" id="scroll-to-request-btn">Select Services</a>
              </div>
            </div>

            <div id="booking-request-panel" style="display:none; width:100%;">
              <p class="mini-label accent-label">Complete your request</p>
              <form id="booking-request-form" class="booking-form-grid">

                <!-- ── Contact details ── -->
                <div class="booking-form-field">
                  <label for="client-full-name" class="booking-form-label">Full name</label>
                  <input id="client-full-name" name="fullName" type="text" class="booking-form-input" placeholder="Client full name" required />
                </div>
                <div class="booking-form-field">
                  <label for="client-email" class="booking-form-label">Email</label>
                  <input id="client-email" name="email" type="email" class="booking-form-input" placeholder="client@email.com" required />
                </div>
                <div class="booking-form-field">
                  <label for="client-phone" class="booking-form-label">Phone</label>
                  <input id="client-phone" name="phone" type="tel" class="booking-form-input" placeholder="6471234567" />
                </div>
                <div class="booking-form-field">
                  <label for="property-address" class="booking-form-label">Property address</label>
                  <input id="property-address" name="propertyAddress" type="text" class="booking-form-input" placeholder="63 Candlewood Drive, Guelph" />
                </div>

                <!-- ── Package options (moved into form) ── -->
                <div class="booking-form-full">
                  <div class="booking-pkg-options-box">
                    <p class="booking-pkg-options-title">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                      Package Options
                    </p>
                    <p class="booking-pkg-options-note">These apply to all selected services. Choose N/A if not applicable.</p>
                    <div class="booking-pkg-options-grid">
                      <label class="booking-pkg-options-label">
                        <span>Square footage</span>
                        <div class="select-wrap">
                          <select id="pkg-square-footage" class="booking-select" data-pkg-field="squareFootage">
                            <option value="0" data-label="N/A">N/A</option>
                            <option value="0" data-label="Under 1,000 sq ft">Under 1,000 sq ft</option>
                            <option value="20" data-label="1,000–1,500 sq ft">1,000–1,500 sq ft</option>
                            <option value="45" data-label="1,500–2,500 sq ft">1,500–2,500 sq ft</option>
                            <option value="80" data-label="2,500–3,500 sq ft">2,500–3,500 sq ft</option>
                            <option value="130" data-label="3,500+ sq ft">3,500+ sq ft</option>
                          </select>
                        </div>
                      </label>
                      <label class="booking-pkg-options-label">
                        <span>Property type</span>
                        <div class="select-wrap">
                          <select id="pkg-property-type" class="booking-select" data-pkg-field="propertyType">
                            <option value="0" data-label="N/A">N/A</option>
                            <option value="0" data-label="Residential">Residential</option>
                            <option value="25" data-label="Commercial">Commercial</option>
                            <option value="40" data-label="Luxury / High-end">Luxury / High-end</option>
                          </select>
                        </div>
                      </label>
                      <label class="booking-pkg-options-label">
                        <span>Turnaround</span>
                        <div class="select-wrap">
                          <select id="pkg-turnaround" class="booking-select" data-pkg-field="turnaround">
                            <option value="0" data-label="N/A">N/A</option>
                            <option value="0" data-label="Standard (2–3 days)">Standard (2–3 days)</option>
                            <option value="40" data-label="Rush (next day)">Rush (next day)</option>
                            <option value="75" data-label="Same day">Same day</option>
                          </select>
                        </div>
                      </label>
                      <label class="booking-pkg-options-label">
                        <span>Add-on</span>
                        <div class="select-wrap">
                          <select id="pkg-addon" class="booking-select" data-pkg-field="addon">
                            <option value="0" data-label="N/A">N/A</option>
                            <option value="0" data-label="No add-on">No add-on</option>
                            <option value="35" data-label="Twilight / dusk shoot">Twilight / dusk shoot (+$35)</option>
                            <option value="50" data-label="Floor plan">Floor plan (+$50)</option>
                            <option value="25" data-label="Extra editing round">Extra editing round (+$25)</option>
                          </select>
                        </div>
                      </label>
                    </div>
                    <p class="booking-pkg-estimate">Estimated total: <strong id="pkg-live-total">$0.00</strong> + HST</p>
                  </div>
                </div>

                <!-- ── Selected package summary ── -->
                <div class="booking-form-full booking-package-box">
                  <p class="booking-form-label">Selected package</p>
                  <h3 id="request-package-summary" class="booking-package-title">No package selected</h3>
                  <div id="request-package-items" class="booking-package-items"></div>
                  <p id="request-package-total" class="booking-package-total">Estimated total: $0 + HST</p>
                  <input id="request-package-summary-input" type="hidden" name="packageSummary" />
                  <input id="request-package-total-input" type="hidden" name="displayTotal" />
                </div>

                <!-- ── Project notes (auto-populated) ── -->
                <div class="booking-form-field booking-form-full">
                  <label for="client-notes" class="booking-form-label">Project notes <span class="notes-auto-badge">auto-filled · editable</span></label>
                  <textarea id="client-notes" name="notes" rows="5" class="booking-form-textarea" placeholder="Notes will be auto-generated from your selections above..."></textarea>
                </div>

                <div class="booking-form-full booking-form-actions">
                  <button id="submit-booking-request" type="submit" class="primary-btn btn-ripple">Save request and open calendar</button>
                  <p id="booking-request-status"></p>
                </div>
              </form>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="section-shell footer-inner">
        <div class="footer-brand-block">
          <div class="footer-emblem" aria-hidden="true">JA</div>
          <div>
            <p class="footer-brand">J Arts 360 View</p>
            <p class="footer-copy">Real estate photography, drone media, cinematic video, and 3D tours for stronger listing presentation.</p>
          </div>
        </div>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="#services">Services</a>
          <a href="#tours">3D Tours</a>
          <a href="#portfolio">Portfolio</a>
          <a href="#book">Book</a>
          <a href={portalLoginUrl} target="_blank" rel="noopener noreferrer">Client Portal</a>
        </nav>
        <p class="footer-legal">&copy; {new Date().getFullYear()} J Arts 360 View. All rights reserved.</p>
      </div>
    </footer>

    <div id="lightbox-modal" class="lightbox-modal hidden" role="dialog" aria-modal="true" aria-label="Image viewer" aria-hidden="true">
      <button id="lightbox-close" class="lightbox-close" aria-label="Close viewer" type="button">×</button>
      <button id="lightbox-prev" class="lightbox-nav lightbox-prev" aria-label="Previous image" type="button">‹</button>
      <img id="lightbox-image" src="" alt="Full-size property photo" class="lightbox-image" />
      <button id="lightbox-next" class="lightbox-nav lightbox-next" aria-label="Next image" type="button">›</button>
      <div class="lightbox-counter" id="lightbox-counter" aria-live="polite"></div>
    </div>

    <script is:inline>
      (function (C, A, L) {
        let p = function (a, ar) { a.q.push(ar); };
        let d = C.document;
        C.Cal = C.Cal || function () {
          let cal = C.Cal;
          let ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement('script')).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api = function () { p(api, arguments); };
            const namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === 'string') {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ['initNamespace', namespace]);
            } else {
              p(cal, ar);
            }
            return;
          }
          p(cal, ar);
        };
      })(window, 'https://app.cal.com/embed/embed.js', 'init');
      Cal('init', '30min', { origin: 'https://app.cal.com' });
      Cal.config = Cal.config || {};
      Cal.config.forwardQueryParams = true;
      Cal.ns['30min']('ui', { hideEventTypeDetails: false, layout: 'month_view' });
    </script>

    <script define:vars={{ portalApiBase, calLink }}>
      document.addEventListener('DOMContentLoaded', () => {

        // ── Scroll reveal ──────────────────────────────────────────────────────
        const revealObs = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              revealObs.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.reveal-item').forEach((el) => revealObs.observe(el));

        // ── Nav active state ───────────────────────────────────────────────────
        const navLinks = document.querySelectorAll('.nav-link[href^="#"]');
        const sectionObs = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              navLinks.forEach((link) => link.classList.remove('nav-active'));
              const active = document.querySelector(`.nav-link[href="#${entry.target.id}"]`);
              active?.classList.add('nav-active');
            }
          });
        }, { threshold: 0.35 });
        document.querySelectorAll('section[id], header[id]').forEach((section) => sectionObs.observe(section));

        // ── Nav scroll style ───────────────────────────────────────────────────
        const nav = document.getElementById('site-nav');
        window.addEventListener('scroll', () => nav?.classList.toggle('scrolled', window.scrollY > 60), { passive: true });

        // ── Mobile menu ────────────────────────────────────────────────────────
        const menuBtn = document.getElementById('mobile-menu-btn');
        const navEl = document.getElementById('nav-links');
        const overlay = document.getElementById('mobile-overlay');
        const closeMenu = () => {
          navEl?.classList.remove('open');
          menuBtn?.classList.remove('open');
          menuBtn?.setAttribute('aria-expanded', 'false');
          menuBtn?.setAttribute('aria-label', 'Open navigation menu');
          overlay?.classList.remove('visible');
        };

        menuBtn?.addEventListener('click', () => {
          const open = navEl?.classList.toggle('open');
          menuBtn.classList.toggle('open', !!open);
          menuBtn.setAttribute('aria-expanded', String(!!open));
          menuBtn.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
          overlay?.classList.toggle('visible', !!open);
        });

        overlay?.addEventListener('click', closeMenu);
        navEl?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });

        // ── Ripple effect ──────────────────────────────────────────────────────
        document.querySelectorAll('.btn-ripple').forEach((btn) => {
          btn.addEventListener('click', function (e) {
            const rect = this.getBoundingClientRect();
            const rpl = document.createElement('span');
            rpl.className = 'ripple-effect';
            rpl.style.cssText = `left:${e.clientX - rect.left}px;top:${e.clientY - rect.top}px`;
            this.appendChild(rpl);
            rpl.addEventListener('animationend', () => rpl.remove());
          });
        });

        // ── Gallery filters ────────────────────────────────────────────────────
        const filterBtns = document.querySelectorAll('.filter-btn');
        const galleryItems = document.querySelectorAll('.gallery-item');
        const loadMoreWrap = document.getElementById('load-more-container');
        const loadMoreBtn = document.getElementById('load-more-btn');
        let currentFilter = 'all';

        filterBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            filterBtns.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            currentFilter = btn.dataset.filter || 'all';
            galleryItems.forEach((item) => {
              const match = currentFilter === 'all' || item.dataset.category === currentFilter;
              const isExtra = item.classList.contains('extra-image');
              if (match && !isExtra) {
                item.classList.remove('hidden');
                item.style.animation = 'galleryFadeIn 0.35s ease forwards';
              } else {
                item.classList.add('hidden');
              }
            });
            if (loadMoreWrap) loadMoreWrap.style.display = currentFilter === 'all' ? 'flex' : 'none';
          });
        });

        loadMoreBtn?.addEventListener('click', () => {
          galleryItems.forEach((item) => {
            item.classList.remove('extra-image');
            if (currentFilter === 'all' || item.dataset.category === currentFilter) item.classList.remove('hidden');
          });
          loadMoreWrap?.remove();
        });

        // ── Lightbox ───────────────────────────────────────────────────────────
        const lbModal = document.getElementById('lightbox-modal');
        const lbImg = document.getElementById('lightbox-image');
        const lbClose = document.getElementById('lightbox-close');
        const lbPrev = document.getElementById('lightbox-prev');
        const lbNext = document.getElementById('lightbox-next');
        const lbCounter = document.getElementById('lightbox-counter');
        let lbIndex = 0;
        let lbImages = [];

        const getVisible = () => Array.from(document.querySelectorAll('.lightbox-trigger:not(.hidden)')).map((el) => el.dataset.highres || '');
        const updateCounter = () => { if (lbCounter) lbCounter.textContent = `${lbIndex + 1} / ${lbImages.length}`; };
        const openLb = (idx) => {
          lbImages = getVisible();
          lbIndex = idx;
          if (!lbImages[lbIndex] || !lbImg) return;
          lbImg.src = lbImages[lbIndex];
          lbModal?.classList.remove('hidden');
          lbModal?.removeAttribute('aria-hidden');
          document.body.style.overflow = 'hidden';
          updateCounter();
          const multi = lbImages.length > 1;
          if (lbPrev) lbPrev.style.display = multi ? 'flex' : 'none';
          if (lbNext) lbNext.style.display = multi ? 'flex' : 'none';
        };
        const closeLb = () => {
          lbModal?.classList.add('hidden');
          lbModal?.setAttribute('aria-hidden', 'true');
          if (lbImg) lbImg.src = '';
          document.body.style.overflow = '';
        };
        const navigate = (dir) => {
          if (!lbImages.length) return;
          lbIndex = (lbIndex + dir + lbImages.length) % lbImages.length;
          if (lbImg) {
            lbImg.style.opacity = '0';
            setTimeout(() => {
              lbImg.src = lbImages[lbIndex];
              lbImg.style.opacity = '1';
              updateCounter();
            }, 140);
          }
        };
        document.querySelectorAll('.lightbox-trigger').forEach((trigger, i) => trigger.addEventListener('click', () => openLb(i)));
        lbClose?.addEventListener('click', closeLb);
        lbPrev?.addEventListener('click', () => navigate(-1));
        lbNext?.addEventListener('click', () => navigate(1));
        lbModal?.addEventListener('click', (e) => { if (e.target === lbModal) closeLb(); });
        document.addEventListener('keydown', (e) => {
          if (lbModal?.classList.contains('hidden')) return;
          if (e.key === 'Escape') closeLb();
          if (e.key === 'ArrowLeft') navigate(-1);
          if (e.key === 'ArrowRight') navigate(1);
        });

        // ── Package builder ────────────────────────────────────────────────────
        const builderBar = document.getElementById('package-builder-bar');
        const countDisplay = document.querySelector('.package-count');
        const totalDisplay = document.querySelector('.package-total');
        const checkoutBtn = document.getElementById('package-checkout-btn');
        const placeholderState = document.getElementById('booking-placeholder-state');
        const requestPanel = document.getElementById('booking-request-panel');
        const statusEl = document.getElementById('booking-request-status');
        const summaryEl = document.getElementById('request-package-summary');
        const itemsEl = document.getElementById('request-package-items');
        const totalEl = document.getElementById('request-package-total');
        const summaryInput = document.getElementById('request-package-summary-input');
        const totalInput = document.getElementById('request-package-total-input');
        const requestForm = document.getElementById('booking-request-form');
        const submitBtn = document.getElementById('submit-booking-request');

        let selectedItems = [];

        function money(n) { return `$${Number(n).toFixed(2)}`; }

        // ── Auto-note generator ───────────────────────────────────────────────
        function getOptionLabel(id) {
          const el = document.getElementById(id);
          if (!el) return 'N/A';
          const opt = el.options[el.selectedIndex];
          return opt?.dataset?.label || opt?.text || 'N/A';
        }

        function buildAutoNote() {
          if (!selectedItems.length) return '';
          const services = selectedItems.map((i) => `${i.serviceName} (${money(i.lineTotal)})`).join(', ');
          const sqft    = getOptionLabel('pkg-square-footage');
          const ptype   = getOptionLabel('pkg-property-type');
          const turn    = getOptionLabel('pkg-turnaround');
          const addon   = getOptionLabel('pkg-addon');
          const total   = selectedItems.reduce((s, i) => s + Number(i.lineTotal || 0), 0);
          return `Services: ${services}

Property details:
- Square footage: ${sqft}
- Property type: ${ptype}
- Turnaround: ${turn}
- Add-on: ${addon}

Estimated total: ${money(total)} + HST

(Auto-generated — feel free to add or edit below)`;
        }

        function autoFillNotes() {
          const notesEl = document.getElementById('client-notes');
          if (!notesEl) return;
          // Only auto-fill if empty or previously auto-filled (starts with "Services:")
          const current = notesEl.value.trim();
          if (current === '' || current.startsWith('Services:')) {
            notesEl.value = buildAutoNote();
          }
        }

        function renderSelectedPackage() {
          const total = selectedItems.reduce((sum, item) => sum + Number(item.lineTotal || 0), 0);
          if (selectedItems.length === 0) {
            if (builderBar) builderBar.classList.add('hidden');
            if (countDisplay) countDisplay.textContent = '0 Services Selected';
            if (totalDisplay) totalDisplay.textContent = 'Estimated: $0 + HST';
            if (summaryEl) summaryEl.textContent = 'No package selected';
            if (itemsEl) itemsEl.innerHTML = '';
            if (totalEl) totalEl.textContent = 'Estimated total: $0 + HST';
            if (summaryInput) summaryInput.value = '';
            if (totalInput) totalInput.value = '0';
            if (placeholderState) placeholderState.style.display = '';
            if (requestPanel) requestPanel.style.display = 'none';
            return;
          }
          if (builderBar) builderBar.classList.remove('hidden');
          if (placeholderState) placeholderState.style.display = 'none';
          if (requestPanel) requestPanel.style.display = '';
          if (countDisplay) countDisplay.textContent = `${selectedItems.length} Service${selectedItems.length > 1 ? 's' : ''} Selected`;
          if (totalDisplay) totalDisplay.textContent = `Estimated: ${money(total)} + HST`;
          if (summaryEl) summaryEl.textContent = selectedItems.map((i) => i.serviceName).join(' + ');
          if (itemsEl) {
            itemsEl.innerHTML = selectedItems.map((item) => `
              <div class="booking-package-line">
                <span>${item.serviceName}</span>
                <span>${money(item.lineTotal)}</span>
              </div>`).join('');
          }
          if (totalEl) totalEl.textContent = `Estimated total: ${money(total)} + HST`;
          if (summaryInput) summaryInput.value = selectedItems.map((i) => i.serviceName).join(' + ');
          if (totalInput) totalInput.value = String(total);
          autoFillNotes();
        }

        // ── Shared package dropdowns ──────────────────────────────────────────
        const pkgDropdowns = document.querySelectorAll('.booking-select');
        const pkgLiveTotal = document.getElementById('pkg-live-total');

        function getSharedAddon() {
          let addon = 0;
          pkgDropdowns.forEach((sel) => { addon += Number(sel.value || 0); });
          return addon;
        }

        function updatePkgLiveTotal() {
          if (!pkgLiveTotal) return;
          const addon = getSharedAddon();
          const total = selectedItems.reduce((s, item) => {
            const base = Number(document.querySelector(`[data-service-key="${item.serviceCode}"]`)?.dataset.basePrice || 0);
            return s + base + addon;
          }, 0);
          pkgLiveTotal.textContent = `$${total.toFixed(2)}`;
        }

        function recomputeAllPrices() {
          const addon = getSharedAddon();
          selectedItems.forEach((item) => {
            const base = Number(document.querySelector(`[data-service-key="${item.serviceCode}"]`)?.dataset.basePrice || item.unitPrice);
            item.lineTotal = base + addon;
            item.unitPrice = base + addon;
          });
          renderSelectedPackage();
          updatePkgLiveTotal();
          autoFillNotes();
        }

        pkgDropdowns.forEach((sel) => sel.addEventListener('change', recomputeAllPrices));

        // ── Service card toggle ────────────────────────────────────────────────
        document.querySelectorAll('[data-service-card]').forEach((card) => {
          const toggleBtn = card.querySelector('[data-toggle-service]');
          const serviceKey = card.dataset.serviceKey || '';
          const serviceName = card.dataset.serviceName || '';
          const basePrice = Number(card.dataset.basePrice || 0);

          toggleBtn?.addEventListener('click', () => {
            const addon = getSharedAddon();
            const price = basePrice + addon;
            const idx = selectedItems.findIndex((i) => i.serviceCode === serviceKey);
            if (idx !== -1) {
              selectedItems.splice(idx, 1);
              card.classList.remove('selected');
              toggleBtn.classList.remove('selected');
              const btnText = toggleBtn.querySelector('.btn-text');
              if (btnText) btnText.textContent = 'Add to Package';
              const iconEl = toggleBtn.querySelector('svg');
              if (iconEl) iconEl.innerHTML = '<path d="M12 5v14M5 12h14"/>';
            } else {
              selectedItems.push({ serviceCode: serviceKey, serviceName, unitPrice: price, lineTotal: price, quantity: 1 });
              card.classList.add('selected');
              toggleBtn.classList.add('selected');
              const btnText = toggleBtn.querySelector('.btn-text');
              if (btnText) btnText.textContent = 'Remove Service';
              const iconEl = toggleBtn.querySelector('svg');
              if (iconEl) iconEl.innerHTML = '<path d="M5 12h14"/>';
            }
            renderSelectedPackage();
            updatePkgLiveTotal();
          });
        });

        checkoutBtn?.addEventListener('click', () => {
          document.getElementById('book')?.scrollIntoView({ behavior: 'smooth' });
        });

        // ── Cal.com opener — polls until Cal embed is ready ────────────────────
        function openCalBooking(data) {
          const calPrefill = data?.calPayload || {};
          function tryOpen(attempts) {
            if (window.Cal && window.Cal.ns && window.Cal.ns['30min']) {
              window.Cal.ns['30min']('modal', {
                calLink: calLink,
                config: { layout: 'month_view', theme: 'dark' },
                ...(calPrefill.name || calPrefill.email
                  ? { responses: { name: calPrefill.name, email: calPrefill.email, notes: calPrefill.notes } }
                  : {})
              });
            } else if (attempts < 15) {
              setTimeout(() => tryOpen(attempts + 1), 300);
            } else {
              window.open(`https://cal.com/${calLink}`, '_blank');
            }
          }
          tryOpen(0);
        }

        // ── Booking form submit ────────────────────────────────────────────────
        async function createBookingRequestAndOpenCal(event) {
          event.preventDefault();

          if (!selectedItems.length) {
            if (statusEl) {
              statusEl.className = 'is-error';
              statusEl.innerHTML = '&#9888; Please <a href="#services" style="color:var(--accent-soft);text-decoration:underline">select at least one service</a> above first.';
            }
            document.getElementById('services')?.scrollIntoView({ behavior: 'smooth' });
            return;
          }

          const fullName = document.getElementById('client-full-name')?.value?.trim() || '';
          const email = document.getElementById('client-email')?.value?.trim() || '';
          const phone = document.getElementById('client-phone')?.value?.trim() || '';
          const propertyAddress = document.getElementById('property-address')?.value?.trim() || '';
          const notes = document.getElementById('client-notes')?.value?.trim() || buildAutoNote();
          const packageSummary = summaryInput?.value || selectedItems.map((item) => item.serviceName).join(' + ');
          const displayTotal = Number(totalInput?.value || 0);

          if (!fullName || !email) {
            if (statusEl) {
              statusEl.className = 'is-error';
              statusEl.textContent = '\u26A0 Full name and email are required.';
            }
            return;
          }

          const payload = {
            fullName, email, phone, propertyAddress, notes, packageSummary, displayTotal,
            selectedServices: selectedItems.map((item) => ({
              service_code: item.serviceCode,
              service_name: item.serviceName,
              unit_price: item.unitPrice,
              quantity: item.quantity || 1
            })),
            source: 'marketing_site'
          };

          try {
            if (submitBtn) submitBtn.setAttribute('disabled', 'true');
            if (statusEl) {
              statusEl.className = 'is-loading';
              statusEl.textContent = 'Saving your request\u2026';
            }

            const response = await fetch(`${portalApiBase}/api/public/bookings`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            const data = await response.json();
            if (!response.ok) throw new Error(data.error || 'Could not save booking request');

            if (statusEl) {
              statusEl.className = 'is-success';
              statusEl.textContent = `\u2713 Saved \u2014 Ref: ${data.reference}. Opening calendar\u2026`;
            }
            openCalBooking(data);
          } catch (error) {
            console.error(error);
            if (statusEl) {
              statusEl.className = 'is-error';
              statusEl.textContent = `\u26A0 ${error?.message || 'Something went wrong. Please try again.'}`;
            }
          } finally {
            if (submitBtn) submitBtn.removeAttribute('disabled');
          }
        }

        requestForm?.addEventListener('submit', createBookingRequestAndOpenCal);
        renderSelectedPackage();
      });
    </script>
  </body>
</html>