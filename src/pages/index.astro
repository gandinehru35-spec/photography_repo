---
import '../styles/global.css';
import { Image } from 'astro:assets';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/*.{avif,AVIF,webp,WEBP,jpg,JPG,jpeg,JPEG,png,PNG,svg,SVG}',
  { eager: true }
);

const allItems = Object.entries(imageFiles).map(([path, file]) => {
  const img = file.default;
  const filename = path.split('/').pop() || '';
  return {
    image: img,
    filename,
    category: filename.toUpperCase().includes('DJI') ? 'aerial' : 'interior'
  };
});

const heroCollageFilenames = [
  'JAR05747.avif',
  'JAR05750.avif',
  'JAR05753.avif',
  'JAR05756.avif',
  'JAR05759.avif'
];

const heroCollageItems = heroCollageFilenames
  .map((targetName) =>
    allItems.find((item) => item.filename.toLowerCase() === targetName.toLowerCase())
  )
  .filter(Boolean);

const heroFileSet = new Set(heroCollageItems.map((item) => item?.filename.toLowerCase()));

const preferredInteriorItems = heroCollageFilenames
  .map((targetName) =>
    allItems.find((item) => item.filename.toLowerCase() === targetName.toLowerCase())
  )
  .filter(Boolean)
  .map((item) => ({ ...item, category: 'interior' }));

const remainingGalleryItems = allItems.filter(
  (item) => !heroFileSet.has(item.filename.toLowerCase())
);

const orderedGalleryItems = [...preferredInteriorItems, ...remainingGalleryItems];
const initialGallery = orderedGalleryItems.slice(0, 9);
const extendedGallery = orderedGalleryItems.slice(9);

const portalBaseUrl = 'https://jarts-client-portal.aneeqpatelcuts.workers.dev';
const portalLoginUrl  = `${portalBaseUrl}/login`;
const portalSignupUrl = `${portalBaseUrl}/signup`;
