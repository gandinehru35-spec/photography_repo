---
import '../styles/global.css';
import { Image } from 'astro:assets';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/*.{avif,AVIF,webp,WEBP,jpg,JPG,jpeg,JPEG,png,PNG,svg,SVG}',
  { eager: true }
);

const allItems = Object.entries(imageFiles).map(([path, file]) => {
  const img = file.default;
  const filename = path.split('/').pop() || '';

  return {
    image: img,
    filename,
    category: filename.toUpperCase().includes('DJI') ? 'aerial' : 'interior'
  };
});

const heroCollageFilenames = [
  'JAR05747.avif',
  'JAR05750.avif',
  'JAR05753.avif',
  'JAR05756.avif',
  'JAR05759.avif'
];

const heroCollageItems = heroCollageFilenames
  .map((targetName) =>
    allItems.find((item) => item.filename.toLowerCase() === targetName.toLowerCase())
  )
  .filter(Boolean);

const heroFileSet = new Set(
  heroCollageItems.map((item) => item?.filename.toLowerCase())
);

const preferredInteriorItems = heroCollageFilenames
  .map((targetName) =>
    allItems.find((item) => item.filename.toLowerCase() === targetName.toLowerCase())
  )
  .filter(Boolean)
  .map((item) => ({
    ...item,
    category: 'interior'
  }));

const remainingGalleryItems = allItems.filter(
  (item) => !heroFileSet.has(item.filename.toLowerCase())
);

const orderedGalleryItems = [...preferredInteriorItems, ...remainingGalleryItems];

const initialGallery = orderedGalleryItems.slice(0, 9);
const extendedGallery = orderedGalleryItems.slice(9);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>J Arts 360 View | Premium Real Estate Media</title>
    <meta
      name="description"
      content="Premium real estate photography, drone media, cinematic video, and 3D tours for listings that deserve better presentation."
    />
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <nav class="site-nav">
      <div class="nav-inner">
        <a href="/" class="brand-mark" aria-label="J Arts 360 View home">
          <img
            src="/logo.png"
            alt="J Arts 360 View Logo"
            class="brand-logo"
          />
          <div class="brand-copy">
            <span class="brand-name">J Arts 360 View</span>
            <span class="brand-tagline">Real Estate Media</span>
