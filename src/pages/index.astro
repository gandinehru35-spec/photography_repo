---
import '../styles/global.css';
import { Image } from 'astro:assets';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/*.{avif,AVIF,webp,WEBP,jpg,JPG,jpeg,JPEG,png,PNG,svg,SVG}',
  { eager: true }
);

const allItems = Object.entries(imageFiles).map(([path, file]) => {
  const img = file.default;
  const filename = path.split('/').pop() || '';
  return {
    image: img,
    filename,
    category: filename.toUpperCase().includes('DJI') ? 'aerial' : 'interior'
  };
});

const heroCollageFilenames = [
  'JAR05747.avif',
  'JAR05750.avif',
  'JAR05753.avif',
  'JAR05756.avif',
  'JAR05759.avif'
];

const heroCollageItems = heroCollageFilenames
  .map((targetName) => allItems.find((item) => item.filename.toLowerCase() === targetName.toLowerCase()))
  .filter(Boolean);

const heroFileSet = new Set(heroCollageItems.map((item) => item?.filename.toLowerCase()));

const preferredInteriorItems = heroCollageFilenames
  .map((targetName) => allItems.find((item) => item.filename.toLowerCase() === targetName.toLowerCase()))
  .filter(Boolean)
  .map((item) => ({ ...item, category: 'interior' }));

const remainingGalleryItems = allItems.filter((item) => !heroFileSet.has(item.filename.toLowerCase()));
const orderedGalleryItems = [...preferredInteriorItems, ...remainingGalleryItems];

// GOLD STANDARD FIX: Limit initial gallery to exactly 2 items
const initialGallery = orderedGalleryItems.slice(0, 2);
const extendedGallery = orderedGalleryItems.slice(2);

const portalBaseUrl = 'https://jarts-client-portal.aneeqpatelcuts.workers.dev';
const portalLoginUrl = `${portalBaseUrl}/login`;
const portalSignupUrl = `${portalBaseUrl}/signup`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>J Arts 360 View | Cinematic Real Estate Media</title>
    <meta name="description" content="Immersive real estate photography and cinematic walkthroughs. Serving Guelph & GTA." />
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="mobile-overlay" id="mobile-overlay" aria-hidden="true"></div>

    <div class="nav-wrapper">
      <nav class="site-nav" id="site-nav">
        <a href="/" class="cinematic-brand" aria-label="Home">
          <span class="brand-emblem-core">J</span>
          <span class="brand-name-main">Arts 360</span>
        </a>

        <div class="nav-links" id="nav-links" role="navigation">
          <a href="#services" class="nav-link">The Services</a>
          <a href="#portfolio" class="nav-link">The Archive</a>
          <a href={portalLoginUrl} target="_blank" rel="noopener noreferrer" class="nav-link">Client Portal</a>
        </div>
        
        <div style="pointer-events: auto;">
           <a href="#book" class="nav-cta" style="margin-left: 1rem; font-family: 'Montserrat'; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase;">Book Shoot</a>
        </div>

        <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Menu" type="button">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </nav>
    </div>

    <main id="main-content">
      <header class="hero" id="hero">
        <div class="hero-bg">
          {heroCollageItems[0] ? (
            <Image src={heroCollageItems[0]!.image} alt="Background" loading="eager" fetchpriority="high" />
          ) : null}
        </div>
        <div class="section-shell" style="z-index: 2;">
          <p class="eyebrow reveal-item">Guelph & Greater Toronto Area</p>
          <h1 class="hero-title reveal-item">The Visual<br/>Experience.</h1>
          <p class="hero-text reveal-item">
            Immersive photography, cinematic storytelling, and spatial mapping designed to elevate listings into digital experiences.
          </p>
          <div class="reveal-item">
            <a href="#services" class="primary-btn">Explore Packages</a>
          </div>
        </div>
      </header>

      <section id="services" class="section-pad" style="overflow: hidden;">
        <div class="section-shell">
          <p class="eyebrow" style="text-align: center;">Production Capabilities</p>
          <h2 class="section-title" style="text-align: center; margin-bottom: 2rem;">Build Your Narrative.</h2>
          
          <div class="services-grid">
            
            <article class="service-card reveal-item">
              <span class="service-number">01</span>
              <h3>Listing Photography</h3>
              <p>Clean composition, balanced light, and true-color editing. Delivered in high-resolution and MLS-optimized formats.</p>
              <p class="service-price">From $120</p>
              <button class="toggle-service-btn" data-service="Listing Photography" data-price="120" type="button">
                <span class="btn-text">Add to Timeline</span>
              </button>
            </article>

            <article class="service-card reveal-item">
              <span class="service-number">02</span>
              <h3>Cinematic Video</h3>
              <p>Smooth, stabilized walkthroughs highlighting architectural flow, scale, and premium finishes.</p>
              <p class="service-price">From $150</p>
              <button class="toggle-service-btn" data-service="Cinematic Video" data-price="150" type="button">
                <span class="btn-text">Add to Timeline</span>
              </button>
            </article>

            <article class="service-card reveal-item">
              <span class="service-number">03</span>
              <h3>Drone Aerials</h3>
              <p>Elevated perspectives establishing lot boundaries, neighborhood context, and striking exterior elevations.</p>
              <p class="service-price">From $99</p>
              <button class="toggle-service-btn" data-service="Drone Aerial" data-price="99" type="button">
                <span class="btn-text">Add to Timeline</span>
              </button>
            </article>

            <article class="service-card reveal-item">
              <span class="service-number">04</span>
              <h3>3D Virtual Tours</h3>
              <p>Immersive spatial mapping allowing out-of-town buyers to walk the floorplan digitally at their own pace.</p>
              <p class="service-price">From $200</p>
              <button class="toggle-service-btn" data-service="3D Virtual Tours" data-price="200" type="button">
                <span class="btn-text">Add to Timeline</span>
              </button>
            </article>

            <article class="service-card reveal-item">
              <span class="service-number">05</span>
              <h3>Signboard Placement</h3>
              <p>Professional installation of standard real estate signage at the property boundary during the media shoot.</p>
              <p class="service-price">From $50</p>
              <button class="toggle-service-btn" data-service="Signboard Placement" data-price="50" type="button">
                <span class="btn-text">Add to Timeline</span>
              </button>
            </article>

          </div>
        </div>
      </section>

      <section id="portfolio" class="section-pad portfolio-section">
        <div class="section-shell">
          <h2 class="section-title" style="text-align: center;">The Archive.</h2>
          
          <div class="filter-row" id="filter-controls">
            <button class="filter-btn" data-filter="all" type="button">All Media</button>
            <button class="filter-btn active" data-filter="interior" type="button">Interiors</button>
            <button class="filter-btn" data-filter="aerial" type="button">Aerials</button>
          </div>

          <div class="gallery-grid asymmetric-mode" id="gallery-grid">
            {orderedGalleryItems.map((item) => (
              <button class="gallery-item lightbox-trigger hidden" data-category={item.category} data-highres={item.image.src} type="button">
                <Image src={item.image} alt="Cinematic Property Media" class="gallery-image" loading="lazy" />
              </button>
            ))}
          </div>

          <div style="margin-top: 5rem; text-align: center;" id="load-more-container">
            <button id="load-more-btn" class="secondary-btn" type="button">View Full Archive</button>
          </div>
        </div>
      </section>

      <section id="book" class="section-pad">
        <div class="section-shell booking-layout">
          <div>
            <p class="eyebrow">Booking & Availability</p>
            <h2 class="section-title">Schedule<br/>Production.</h2>
            <p style="color: var(--muted); margin-bottom: 2rem; font-size: 1.1rem;">
              Reserve a shoot date for your next property or reach out directly for pricing, availability, and tailored media packages.
            </p>
            
            <div class="contact-stack">
              <div class="contact-item">
                <span class="contact-badge">DIRECT LINE</span>
                <a href="tel:6477103982">647 710 3982</a>
              </div>
              <div class="contact-item">
                <span class="contact-badge">ELECTRONIC MAIL</span>
                <a href="mailto:jarts360view@gmail.com">jarts360view@gmail.com</a>
              </div>
            </div>
          </div>

          <div class="booking-panel" style="padding: 3rem; border: 1px solid var(--glass-border); border-radius: 16px; background: rgba(255,255,255,0.015); backdrop-filter: blur(10px); text-align: center;">
            <div class="booking-placeholder">
              <h3 style="font-size: 1.8rem; margin-bottom: 1rem;">Book your shoot</h3>
              <p style="color: var(--muted); margin-bottom: 2rem;">Choose a time that works for you directly in our live calendar. Instant confirmation sent to your email.</p>
              <div class="booking-actions" style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
                <a href="#" class="primary-btn"
                   data-cal-link="jarts/30min"
                   data-cal-namespace="30min"
                   data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}'>
                  Open Booking Calendar
                </a>
                <a href="mailto:jarts360view@gmail.com" class="secondary-btn">Email Us</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div id="package-builder-bar" class="package-builder-bar hidden">
        <div class="package-info">
          <span class="package-count">0 Items Selected</span>
          <span class="package-total">Est: $0 + HST</span>
        </div>
        <button id="package-checkout-btn" class="package-checkout-btn" type="button">Review Order</button>
      </div>
    </main>

    <footer class="site-footer">
      <div class="section-shell">
        <div class="footer-emblem">J</div>
        <div class="footer-links">
          <a href="#services">Services</a>
          <a href="#portfolio">Archive</a>
          <a href={portalLoginUrl}>Client Portal</a>
        </div>
        <p class="footer-legal">&copy; {new Date().getFullYear()} J ARTS 360 VIEW. ALL RIGHTS RESERVED.</p>
      </div>
    </footer>

    <script type="text/javascript">
      (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
      Cal("init", "30min", {origin:"https://app.cal.com"});
      Cal.config = Cal.config || {};
      Cal.config.forwardQueryParams = true;

      Cal.ns["30min"]("floatingButton", {"calLink":"jarts/30min","config":{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}}); 
      Cal.ns["30min"]("ui", {"hideEventTypeDetails":false,"layout":"month_view"});
    </script>

    <script>
      document.addEventListener('DOMContentLoaded', () => {

        // Scroll reveal
        const revealObs = new IntersectionObserver((entries) => { entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('revealed'); revealObs.unobserve(entry.target); } }); }, { threshold: 0.1 });
        document.querySelectorAll('.reveal-item').forEach((el) => revealObs.observe(el));

        // Mobile Menu Nav
        const menuBtn = document.getElementById('mobile-menu-btn');
        const navEl = document.getElementById('nav-links');
        const overlay = document.getElementById('mobile-overlay');
        
        menuBtn?.addEventListener('click', () => { 
          const isOpen = navEl?.classList.toggle('open'); 
          if(overlay) overlay.classList.toggle('visible', isOpen);
        });
        overlay?.addEventListener('click', () => {
          navEl?.classList.remove('open');
          overlay.classList.remove('visible');
        });

        const nav = document.querySelector('.site-nav');
        window.addEventListener('scroll', () => nav?.classList.toggle('scrolled', window.scrollY > 60), { passive: true });

        // ── STRICT 2-PHOTO GALLERY LOGIC ── //
        const filterBtns = document.querySelectorAll('.filter-btn');
        const galleryItems = document.querySelectorAll('.gallery-item');
        const galleryGrid = document.getElementById('gallery-grid');
        const loadMoreWrap = document.getElementById('load-more-container');
        const loadMoreBtn = document.getElementById('load-more-btn');
        
        let currentFilter = 'interior'; // Default as requested
        let isExpanded = false;

        function renderGallery() {
          let visibleCount = 0;

          galleryItems.forEach((item) => {
            const match = currentFilter === 'all' || item.dataset.category === currentFilter;
            
            if (match) {
              if (isExpanded || visibleCount < 2) {
                item.classList.remove('hidden');
                item.style.animation = 'none';
                item.offsetHeight; // force reflow
                item.style.animation = 'galleryFadeIn 0.8s ease forwards';
                visibleCount++;
              } else {
                item.classList.add('hidden');
              }
            } else {
              item.classList.add('hidden');
            }
          });

          const totalCategoryItems = Array.from(galleryItems).filter(i => currentFilter === 'all' || i.dataset.category === currentFilter).length;
          
          if (!isExpanded && totalCategoryItems > 2) {
            if (loadMoreWrap) loadMoreWrap.style.display = 'block';
            galleryGrid?.classList.add('asymmetric-mode');
          } else {
            if (loadMoreWrap) loadMoreWrap.style.display = 'none';
            galleryGrid?.classList.remove('asymmetric-mode');
          }
        }

        filterBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            filterBtns.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            currentFilter = btn.dataset.filter || 'interior';
            isExpanded = false; 
            renderGallery();
          });
        });

        loadMoreBtn?.addEventListener('click', () => {
          isExpanded = true;
          renderGallery();
        });

        // Initialize exactly 2 interior photos on page load
        renderGallery();

        // ── RESTORED BASE PACKAGE BUILDER LOGIC ── //
        const toggleBtns = document.querySelectorAll('.toggle-service-btn');
        const builderBar = document.getElementById('package-builder-bar');
        const countDisplay = document.querySelector('.package-count');
        const totalDisplay = document.querySelector('.package-total');
        const checkoutBtn = document.getElementById('package-checkout-btn');

        let selectedServices = new Map();

        toggleBtns.forEach(btn => {
          btn.addEventListener('click', function() {
            const service = (this).dataset.service;
            const price = parseInt((this).dataset.price || '0');
            const btnText = this.querySelector('.btn-text');

            if (selectedServices.has(service)) {
              selectedServices.delete(service);
              this.classList.remove('selected');
              if (btnText) btnText.textContent = 'Add to Timeline';
            } else {
              selectedServices.set(service, price);
              this.classList.add('selected');
              if (btnText) btnText.textContent = 'Remove from Timeline';
            }

            updateBuilderBar();
          });
        });

        function updateBuilderBar() {
          let total = 0;
          selectedServices.forEach(price => total += price);
          
          if (selectedServices.size > 0) {
            builderBar?.classList.remove('hidden');
            if (countDisplay) countDisplay.textContent = `${selectedServices.size} Items Selected`;
            if (totalDisplay) totalDisplay.textContent = `Est: $${total} + HST`;
          } else {
            builderBar?.classList.add('hidden');
          }
        }

        checkoutBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          
          let notes = "Client has requested the following package:\n\n";
          selectedServices.forEach((price, service) => {
            notes += `- ${service} ($${price})\n`;
          });
          notes += `\nTotal Estimated: $${Array.from(selectedServices.values()).reduce((a, b) => a + b, 0)} + HST`;

          // Check if Cal.com script has loaded and push the custom payload
          if (window.Cal && window.Cal.ns && window.Cal.ns["30min"]) {
            window.Cal.ns["30min"]("modal", {
              calLink: "jarts/30min",
              config: {
                notes: notes,
                layout: "month_view"
              }
            });
          } else {
            // Fallback just in case the calendar embed fails to load
            window.location.href = "#book";
          }
        });

      });
    </script>
  </body>
</html>