---
import '../styles/global.css';
import { Image } from 'astro:assets';

// 1. ROBUST AUTOMATED IMPORT
const imageFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/*.{avif,AVIF,webp,WEBP,jpg,JPG,jpeg,JPEG,png,PNG,svg,SVG}', { eager: true });

// 2. STABLE CATEGORY SELECTION
const allItems = Object.entries(imageFiles).map(([path, file]) => {
  const img = file.default;
  const filename = path.split('/').pop() || '';
  return {
    image: img,
    filename: filename,
    category: filename.toUpperCase().includes('DJI') ? 'aerial' : 'interior'
  };
});

// Isolate the background hero frame
const heroItem = allItems.find(item => item.filename.toLowerCase().includes('housefront'));
const heroBg = heroItem ? heroItem.image : (allItems[0]?.image || '');

// Build the continuous gallery array
const galleryItems = allItems.filter(item => item.image !== heroBg);

// 3. THE CRASH-PROOF SPLIT
// We split the arrays here to completely avoid using 'index' in the HTML mapping.
const initialGallery = galleryItems.slice(0, 12);
const extendedGallery = galleryItems.slice(12);
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-[#050505]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>J ARTS 360 VIEW | Executive Real Estate Media</title>
  </head>
  <body class="text-white font-sans antialiased overflow-x-hidden selection:bg-[#FF1A00] selection:text-white">
    
    <nav class="fixed top-0 w-full z-50 bg-[#050505]/90 backdrop-blur-xl border-b border-white/5 py-4 md:py-6 transition-all duration-300">
      <div class="px-6 md:px-12 flex justify-between items-center max-w-screen-2xl mx-auto">
        <a href="#" class="flex items-center gap-4">
          <img src="/logo.png" alt="J Arts 360 View Logo" class="h-16 md:h-20 w-auto object-contain drop-shadow-2xl" />
        </a>

        <div class="space-x-10 text-xs font-bold tracking-[0.2em] uppercase hidden md:block">
          <a href="#services" class="text-gray-400 hover:text-white transition duration-300">Services</a>
          <a href="#portfolio" class="text-gray-400 hover:text-white transition duration-300">Portfolio</a>
          <a href="#book" class="text-[#FF1A00] hover:text-[#FF4500] transition duration-300">Secure a Shoot</a>
        </div>
      </div>
    </nav>

    <header class="relative pt-48 pb-24 md:pt-56 md:pb-32 px-6 md:px-12 max-w-screen-2xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-5 z-10">
          <p class="text-[#FF1A00] font-bold tracking-[0.3em] text-xs uppercase mb-6">We Show The New Reality</p>
          <h1 class="text-5xl md:text-7xl font-extrabold tracking-tighter mb-8 leading-[1.05] text-white">
            Space.<br/>
            Scale.<br/>
            Vision.
          </h1>
          <p class="text-lg text-gray-400 mb-10 leading-relaxed font-light max-w-md">
            Executive-grade photography, cinematic video, and immersive 3D virtual tours deployed for Southwestern Ontario's premium listings.
          </p>
          <div class="flex flex-wrap gap-6 items-center">
            <a href="#book" class="bg-[#FF1A00] text-white px-10 py-4 rounded-sm font-bold text-xs tracking-[0.15em] uppercase hover:bg-white hover:text-black transition-all duration-300 shadow-[0_0_30px_rgba(255,26,0,0.3)]">
              Initiate Booking
            </a>
            <a href="#portfolio" class="inline-flex items-center gap-3 text-xs font-bold tracking-[0.15em] uppercase text-gray-400 hover:text-white transition-colors">
              View Archive
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>
          </div>
        </div>
        
        <div class="lg:col-span-7 relative w-full aspect-[4/3] lg:aspect-auto lg:h-[700px] rounded-xl overflow-hidden shadow-2xl ring-1 ring-white/10">
          {heroBg && <Image src={heroBg} alt="Premium Listing" class="w-full h-full object-cover scale-105" loading="eager" fetchpriority="high" />}
          <div class="absolute inset-0 bg-gradient-to-r from-[#050505] via-[#050505]/40 to-transparent"></div>
        </div>
      </div>
    </header>

    <section id="services" class="py-32 px-6 md:px-12 bg-[#0A0A0A] border-t border-white/5">
      <div class="max-w-screen-2xl mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-end mb-20 gap-8">
          <div>
            <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-white mb-4">Deployment Packages.</h2>
            <p class="text-gray-500 text-lg font-light">Precision visual assets engineered for MLS dominance.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="p-10 bg-[#050505] border border-white/5 hover:border-white/20 transition-colors duration-500 rounded-sm group">
            <h3 class="text-2xl font-bold mb-4 text-white group-hover:text-[#FF1A00] transition-colors">Listing Photography</h3>
            <p class="text-gray-400 text-sm mb-12 font-light leading-relaxed">Optically perfected interior and exterior captures calibrated for absolute clarity.</p>
            <p class="font-bold text-xl text-white">From $120 <span class="text-xs text-gray-600 font-normal uppercase tracking-widest">+ HST</span></p>
          </div>
          <div class="p-10 bg-[#050505] border border-white/5 hover:border-white/20 transition-colors duration-500 rounded-sm group">
            <h3 class="text-2xl font-bold mb-4 text-white group-hover:text-[#FF1A00] transition-colors">Cinematic Video</h3>
            <p class="text-gray-400 text-sm mb-12 font-light leading-relaxed">Fluid, story-driven architectural walkthroughs stabilizing spatial flow.</p>
            <p class="font-bold text-xl text-white">From $150 <span class="text-xs text-gray-600 font-normal uppercase tracking-widest">+ HST</span></p>
          </div>
          <div class="p-10 bg-[#050505] border border-white/5 hover:border-white/20 transition-colors duration-500 rounded-sm group">
            <h3 class="text-2xl font-bold mb-4 text-white group-hover:text-[#FF1A00] transition-colors">Drone & Aerial</h3>
            <p class="text-gray-400 text-sm mb-12 font-light leading-relaxed">Elevated perspectives securing topographical and neighborhood context.</p>
            <p class="font-bold text-xl text-white">From $99 <span class="text-xs text-gray-600 font-normal uppercase tracking-widest">+ HST</span></p>
          </div>
          <div class="p-10 bg-[#050505] border border-white/5 hover:border-white/20 transition-colors duration-500 rounded-sm group">
            <h3 class="text-2xl font-bold mb-4 text-white group-hover:text-[#FF1A00] transition-colors">3D Virtual Tours</h3>
            <p class="text-gray-400 text-sm mb-12 font-light leading-relaxed">Fully immersive spatial twins allowing unrestricted global access 24/7.</p>
            <p class="font-bold text-xl text-white">From $200 <span class="text-xs text-gray-600 font-normal uppercase tracking-widest">+ HST</span></p>
          </div>
        </div>
      </div>
    </section>

    <main id="portfolio" class="px-6 md:px-12 py-32 max-w-screen-2xl mx-auto border-t border-white/5">
      <div class="flex flex-wrap items-end justify-between mb-16 gap-6">
        <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-white">The Archive.</h2>
        <div class="flex gap-8" id="filter-controls">
          <button class="filter-btn active text-xs font-bold tracking-[0.15em] uppercase border-b-2 border-[#FF1A00] text-white pb-2" data-filter="all">All Specs</button>
          <button class="filter-btn text-xs font-bold tracking-[0.15em] uppercase text-gray-600 hover:text-white pb-2 transition" data-filter="interior">Interiors</button>
          <button class="filter-btn text-xs font-bold tracking-[0.15em] uppercase text-gray-600 hover:text-white pb-2 transition" data-filter="aerial">Aerials</button>
        </div>
      </div>

      <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6" id="gallery-grid">
        
        {initialGallery.map((item) => (
          <div 
            class="gallery-item group relative overflow-hidden bg-[#0A0A0A] rounded-sm cursor-crosshair lightbox-trigger break-inside-avoid ring-1 ring-white/5"
            data-category={item.category}
            data-highres={item.image.src}
          >
            <Image 
              src={item.image} 
              alt="J Arts Master Visual" 
              class="w-full h-auto object-cover transition-all duration-1000 group-hover:scale-105 group-hover:opacity-80" 
            />
            <div class="absolute inset-0 border-2 border-[#FF1A00]/0 group-hover:border-[#FF1A00]/50 transition-colors duration-500 pointer-events-none"></div>
          </div>
        ))}

        {extendedGallery.map((item) => (
          <div 
            class="gallery-item group relative overflow-hidden bg-[#0A0A0A] rounded-sm cursor-crosshair lightbox-trigger break-inside-avoid ring-1 ring-white/5 hidden extra-image"
            data-category={item.category}
            data-highres={item.image.src}
          >
            <Image 
              src={item.image} 
              alt="J Arts Master Visual" 
              loading="lazy"
              class="w-full h-auto object-cover transition-all duration-1000 group-hover:scale-105 group-hover:opacity-80" 
            />
            <div class="absolute inset-0 border-2 border-[#FF1A00]/0 group-hover:border-[#FF1A00]/50 transition-colors duration-500 pointer-events-none"></div>
          </div>
        ))}
      </div>

      {extendedGallery.length > 0 && (
        <div class="flex justify-center mt-20" id="load-more-container">
          <button id="load-more-btn" class="border border-white/20 text-white hover:bg-white hover:text-black px-12 py-5 rounded-sm tracking-[0.2em] uppercase text-xs font-bold transition-all duration-300">
            Access Full Archive
          </button>
        </div>
      )}
    </main>

    <section class="py-32 px-6 md:px-12 bg-[#0A0A0A] border-t border-white/5">
      <div class="max-w-screen-2xl mx-auto">
        <h2 class="text-4xl md:text-5xl font-bold tracking-tight mb-20 text-center text-white">Industry Verification.</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-10 bg-[#050505] border border-white/5 rounded-sm">
            <div class="flex text-[#FF1A00] mb-6 text-xl">★★★★★</div>
            <p class="text-gray-400 font-light leading-relaxed mb-8">"Beautifully clicked the pictures. Professional, prompt & friendly service."</p>
            <p class="font-bold text-white text-xs tracking-widest uppercase">— Monika Bansal</p>
          </div>
          <div class="p-10 bg-[#050505] border border-white/5 rounded-sm">
            <div class="flex text-[#FF1A00] mb-6 text-xl">★★★★★</div>
            <p class="text-gray-400 font-light leading-relaxed mb-8">"Photos they produced were absolutely stunning... Commitment to customer satisfaction is truly impressive. Highly recommend!"</p>
            <p class="font-bold text-white text-xs tracking-widest uppercase">— Sushaant Dhamijaa</p>
          </div>
          <div class="p-10 bg-[#050505] border border-white/5 rounded-sm">
            <div class="flex text-[#FF1A00] mb-6 text-xl">★★★★★</div>
            <p class="text-gray-400 font-light leading-relaxed mb-8">"Consistently delivers outstanding results. Communication about schedules is key for us—highly recommended!"</p>
            <p class="font-bold text-white text-xs tracking-widest uppercase">— Benson Crew</p>
          </div>
        </div>
      </div>
    </section>

    <section id="book" class="py-32 bg-[#050505] border-t border-white/5">
      <div class="max-w-5xl mx-auto px-6 text-center">
        <h2 class="text-4xl md:text-6xl font-extrabold mb-6 text-white tracking-tighter">Secure Operations.</h2>
        <p class="text-gray-500 mb-12 max-w-2xl mx-auto text-lg font-light">Select your visual package below. Calendar availability is strictly enforced.</p>
        
        <div class="flex flex-wrap justify-center gap-10 mb-16 text-xs font-bold tracking-[0.1em] text-white uppercase">
          <span class="flex items-center gap-2"><span class="text-[#FF1A00]">T.</span> (647) 710-3982</span>
          <span class="flex items-center gap-2"><span class="text-[#FF1A00]">E.</span> jartsguelph@gmail.com</span>
          <span class="flex items-center gap-2"><span class="text-[#FF1A00]">HQ.</span> 63 Candlewood Drive, Guelph</span>
        </div>
        
        <div class="bg-[#0A0A0A] border border-white/5 rounded-sm p-8 md:p-12 min-h-[600px] flex items-center justify-center shadow-2xl">
          <div class="text-gray-600 border border-dashed border-gray-800 p-8 rounded-sm w-full bg-[#050505]">
            <p class="font-mono text-sm tracking-widest">[ CAL.COM EMBED SCRIPT LOCATION ]</p>
          </div>
        </div>
      </div>
    </section>

    <footer class="border-t border-white/10 py-12 text-center text-gray-700 text-xs font-bold tracking-widest uppercase bg-[#050505]">
      <p>&copy; 2026 J ARTS 360 VIEW. Architectural Visual Storytelling.</p>
    </footer>

    <div id="lightbox-modal" class="fixed inset-0 z-50 bg-[#050505]/98 hidden items-center justify-center backdrop-blur-xl opacity-0 transition-opacity duration-500">
      <button id="lightbox-close" class="absolute top-8 right-8 text-gray-500 hover:text-white transition-colors p-4 mix-blend-difference">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
      <img id="lightbox-image" src="" alt="Full Scale Asset" class="max-w-[90vw] max-h-[90vh] object-contain shadow-2xl" />
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        
        // Category Filtering
        const filterBtns = document.querySelectorAll('.filter-btn');
        const galleryItems = document.querySelectorAll('.gallery-item');
        const loadMoreContainer = document.getElementById('load-more-container');
        let currentFilter = 'all';

        filterBtns.forEach(btn => {
          btn.addEventListener('click', (e) => {
            filterBtns.forEach(b => {
              b.classList.remove('active', 'border-b-2', 'border-[#FF1A00]', 'text-white');
              b.classList.add('text-gray-600');
            });
            const target = e.target as HTMLElement;
            target.classList.add('active', 'border-b-2', 'border-[#FF1A00]', 'text-white');
            target.classList.remove('text-gray-600');

            currentFilter = target.getAttribute('data-filter') || 'all';

            galleryItems.forEach(item => {
              const itemCategory = item.getAttribute('data-category');
              const isExtra = item.classList.contains('extra-image');
              
              if (currentFilter === 'all' || currentFilter === itemCategory) {
                if (!isExtra) item.classList.remove('hidden');
              } else {
                item.classList.add('hidden');
              }
            });

            if (loadMoreContainer) {
              loadMoreContainer.style.display = currentFilter === 'all' ? 'flex' : 'none';
            }
          });
        });

        // Pagination Loader (Bypasses Astro logic perfectly)
        const loadMoreBtn = document.getElementById('load-more-btn');
        if (loadMoreBtn) {
          loadMoreBtn.addEventListener('click', () => {
            galleryItems.forEach(item => {
              item.classList.remove('extra-image');
              const itemCategory = item.getAttribute('data-category');
              if (currentFilter === 'all' || currentFilter === itemCategory) {
                item.classList.remove('hidden');
              }
            });
            if (loadMoreContainer) loadMoreContainer.remove();
          });
        }

        // Executive Lightbox
        const modal = document.getElementById('lightbox-modal');
        const modalImage = document.getElementById('lightbox-image');
        const closeBtn = document.getElementById('lightbox-close');
        
        galleryItems.forEach(trigger => {
          trigger.addEventListener('click', () => {
            const highResSource = trigger.getAttribute('data-highres');
            if (modalImage && modal && highResSource) {
              modalImage.setAttribute('src', highResSource);
              modal.classList.remove('hidden');
              modal.classList.add('flex');
              setTimeout(() => modal.classList.remove('opacity-0'), 10);
              document.body.style.overflow = 'hidden';
            }
          });
        });

        const closeModal = () => {
          if (modal) {
            modal.classList.add('opacity-0');
            setTimeout(() => {
              modal.classList.add('hidden');
              modal.classList.remove('flex');
              if (modalImage) modalImage.setAttribute('src', '');
            }, 500); // Slower, smoother fade out
            document.body.style.overflow = 'auto';
          }
        };

        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (modal) {
          modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
          });
        }
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeModal();
        });
      });
    </script>
  </body>
</html>