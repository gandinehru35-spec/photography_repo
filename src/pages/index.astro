        <div class="footer-brand-block">
          <div class="footer-emblem" aria-hidden="true">J</div>
          <div>
            <p class="footer-brand">J Arts 360 View</p>
            <p class="footer-copy">Premium real estate visual storytelling for listings that need better presentation. Guelph &amp; GTA.</p>
          </div>
        </div>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="#services">Services</a>
          <a href="#portfolio">Portfolio</a>
          <a href="#testimonials">Reviews</a>
          <a href="#book">Contact</a>
          <a href={portalLoginUrl} target="_blank" rel="noopener noreferrer" class="footer-portal-link">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Client Portal
          </a>
        </nav>
        <p class="footer-legal">&copy; {new Date().getFullYear()} J Arts 360 View. All rights reserved.</p>
      </div>
    </footer>

    <div id="lightbox-modal" class="lightbox-modal hidden" role="dialog" aria-modal="true" aria-label="Image viewer" aria-hidden="true">
      <button id="lightbox-close" class="lightbox-close" aria-label="Close viewer" type="button">✕</button>
      <button id="lightbox-prev" class="lightbox-nav lightbox-prev" aria-label="Previous image" type="button"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg></button>
      <img id="lightbox-image" src="" alt="Full-size property photo" class="lightbox-image" />
      <button id="lightbox-next" class="lightbox-nav lightbox-next" aria-label="Next image" type="button"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg></button>
      <div class="lightbox-counter" id="lightbox-counter" aria-live="polite"></div>
    </div>

    <script type="text/javascript">
      (function (C, A, L) {
        let p = function (a, ar) { a.q.push(ar); };
        let d = C.document;
        C.Cal = C.Cal || function () {
          let cal = C.Cal;
          let ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement('script')).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api = function () { p(api, arguments); };
            const namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === 'string') {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ['initNamespace', namespace]);
            } else {
              p(cal, ar);
            }
            return;
          }
          p(cal, ar);
        };
      })(window, 'https://app.cal.com/embed/embed.js', 'init');

      Cal('init', '30min', { origin: 'https://app.cal.com' });
      Cal.config = Cal.config || {};
      Cal.config.forwardQueryParams = true;
      Cal.ns['30min']('ui', { hideEventTypeDetails: false, layout: 'month_view' });
    </script>

    <script define:vars={{ portalApiBase, calLink }}>
      document.addEventListener('DOMContentLoaded', () => {

        // ── Scroll reveal ──────────────────────────────────────────────────────
        const revealObs = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              revealObs.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.reveal-item').forEach((el) => revealObs.observe(el));

        // ── Nav active state — FIX #7: clear ALL links before setting active ──
        const navLinks = document.querySelectorAll('.nav-link[href^="#"]');
        const sectionObs = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              navLinks.forEach((link) => link.classList.remove('nav-active'));
              const active = document.querySelector(`.nav-link[href="#${entry.target.id}"]`);
              active?.classList.add('nav-active');
            }
          });
        }, { threshold: 0.35 });
        document.querySelectorAll('section[id], header[id]').forEach((section) => sectionObs.observe(section));

        // ── Nav scroll style ───────────────────────────────────────────────────
        const nav = document.getElementById('site-nav');
        window.addEventListener('scroll', () => nav?.classList.toggle('scrolled', window.scrollY > 60), { passive: true });

        // ── Mobile menu ────────────────────────────────────────────────────────
        const menuBtn = document.getElementById('mobile-menu-btn');
        const navEl = document.getElementById('nav-links');
        const overlay = document.getElementById('mobile-overlay');
        const closeMenu = () => {
          navEl?.classList.remove('open');
          menuBtn?.classList.remove('open');
          menuBtn?.setAttribute('aria-expanded', 'false');
          menuBtn?.setAttribute('aria-label', 'Open navigation menu');
          overlay?.classList.remove('visible');
        };

        menuBtn?.addEventListener('click', () => {
          const open = navEl?.classList.toggle('open');
          menuBtn.classList.toggle('open', !!open);
          menuBtn.setAttribute('aria-expanded', String(!!open));
          menuBtn.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
          overlay?.classList.toggle('visible', !!open);
        });

        overlay?.addEventListener('click', closeMenu);
        navEl?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });

        // ── Ripple effect ──────────────────────────────────────────────────────
        document.querySelectorAll('.btn-ripple').forEach((btn) => {
          btn.addEventListener('click', function (e) {
            const rect = this.getBoundingClientRect();
            const rpl = document.createElement('span');
            rpl.className = 'ripple-effect';
            rpl.style.cssText = `left:${e.clientX - rect.left}px;top:${e.clientY - rect.top}px`;
            this.appendChild(rpl);
            rpl.addEventListener('animationend', () => rpl.remove());
          });
        });

        // ── Proof tooltips ─────────────────────────────────────────────────────
        document.querySelectorAll('.proof-item[data-tooltip]').forEach((el) => {
          const tip = document.createElement('div');
          tip.className = 'proof-tooltip';
          tip.textContent = el.dataset.tooltip || '';
          el.style.position = 'relative';
          el.appendChild(tip);
        });

        // ── Gallery filters ────────────────────────────────────────────────────
        const filterBtns = document.querySelectorAll('.filter-btn');
        const galleryItems = document.querySelectorAll('.gallery-item');
        const loadMoreWrap = document.getElementById('load-more-container');
        const loadMoreBtn = document.getElementById('load-more-btn');
        let currentFilter = 'all';

        filterBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            filterBtns.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            currentFilter = btn.dataset.filter || 'all';
            galleryItems.forEach((item) => {
              const match = currentFilter === 'all' || item.dataset.category === currentFilter;
              const isExtra = item.classList.contains('extra-image');
              if (match && !isExtra) {
                item.classList.remove('hidden');
                item.style.animation = 'galleryFadeIn 0.35s ease forwards';
              } else {
                item.classList.add('hidden');
              }
            });
            if (loadMoreWrap) loadMoreWrap.style.display = currentFilter === 'all' ? 'flex' : 'none';
          });
        });

        loadMoreBtn?.addEventListener('click', () => {
          galleryItems.forEach((item) => {
            item.classList.remove('extra-image');
            if (currentFilter === 'all' || item.dataset.category === currentFilter) item.classList.remove('hidden');
          });
          loadMoreWrap?.remove();
        });

        // ── Lightbox ───────────────────────────────────────────────────────────
        const lbModal = document.getElementById('lightbox-modal');
        const lbImg = document.getElementById('lightbox-image');
        const lbClose = document.getElementById('lightbox-close');
        const lbPrev = document.getElementById('lightbox-prev');
        const lbNext = document.getElementById('lightbox-next');
        const lbCounter = document.getElementById('lightbox-counter');
        let lbIndex = 0;
        let lbImages = [];

        const getVisible = () => Array.from(document.querySelectorAll('.lightbox-trigger:not(.hidden)')).map((el) => el.dataset.highres || '');
        const updateCounter = () => { if (lbCounter) lbCounter.textContent = `${lbIndex + 1} / ${lbImages.length}`; };
        const openLb = (idx) => {
          lbImages = getVisible();
          lbIndex = idx;
          if (!lbImages[lbIndex] || !lbImg) return;
          lbImg.src = lbImages[lbIndex];
          lbModal?.classList.remove('hidden');
          lbModal?.removeAttribute('aria-hidden');
          document.body.style.overflow = 'hidden';
          updateCounter();
          const multi = lbImages.length > 1;
          if (lbPrev) lbPrev.style.display = multi ? 'flex' : 'none';
          if (lbNext) lbNext.style.display = multi ? 'flex' : 'none';
        };
        const closeLb = () => {
          lbModal?.classList.add('hidden');
          lbModal?.setAttribute('aria-hidden', 'true');
          if (lbImg) lbImg.src = '';
          document.body.style.overflow = '';
        };
        const navigate = (dir) => {
          if (!lbImages.length) return;
          lbIndex = (lbIndex + dir + lbImages.length) % lbImages.length;
          if (lbImg) {
            lbImg.style.opacity = '0';
            setTimeout(() => {
              lbImg.src = lbImages[lbIndex];
              lbImg.style.opacity = '1';
              updateCounter();
            }, 140);
          }
        };
        document.querySelectorAll('.lightbox-trigger').forEach((trigger, i) => trigger.addEventListener('click', () => openLb(i)));
        lbClose?.addEventListener('click', closeLb);
        lbPrev?.addEventListener('click', () => navigate(-1));
        lbNext?.addEventListener('click', () => navigate(1));
        lbModal?.addEventListener('click', (e) => { if (e.target === lbModal) closeLb(); });
        document.addEventListener('keydown', (e) => {
          if (lbModal?.classList.contains('hidden')) return;
          if (e.key === 'Escape') closeLb();
          if (e.key === 'ArrowLeft') navigate(-1);
          if (e.key === 'ArrowRight') navigate(1);
        });

        // ── Package builder ────────────────────────────────────────────────────
        const builderBar = document.getElementById('package-builder-bar');
        const countDisplay = document.querySelector('.package-count');
        const totalDisplay = document.querySelector('.package-total');
        const checkoutBtn = document.getElementById('package-checkout-btn');
        const requestPanel = document.getElementById('booking-request-panel');
        const scrollToRequestBtn = document.getElementById('scroll-to-request-btn');
        const statusEl = document.getElementById('booking-request-status');
        const summaryEl = document.getElementById('request-package-summary');
        const itemsEl = document.getElementById('request-package-items');
        const totalEl = document.getElementById('request-package-total');
        const summaryInput = document.getElementById('request-package-summary-input');
        const totalInput = document.getElementById('request-package-total-input');
        const requestForm = document.getElementById('booking-request-form');
        const submitBtn = document.getElementById('submit-booking-request');

        let selectedItems = [];

        function money(n) { return `$${Number(n).toFixed(2)}`; }

        function renderSelectedPackage() {
          const total = selectedItems.reduce((sum, item) => sum + Number(item.lineTotal || 0), 0);
          if (selectedItems.length === 0) {
            if (builderBar) builderBar.classList.add('hidden');
            if (countDisplay) countDisplay.textContent = '0 Services Selected';
            if (totalDisplay) totalDisplay.textContent = 'Estimated: $0 + HST';
            if (summaryEl) summaryEl.textContent = 'No package selected';
            if (itemsEl) itemsEl.innerHTML = '';
            if (totalEl) totalEl.textContent = 'Estimated total: $0 + HST';
            if (summaryInput) summaryInput.value = '';
            if (totalInput) totalInput.value = '0';
            return;
          }
          const summary = selectedItems.map((item) => item.serviceName).join(' + ');
          if (builderBar) builderBar.classList.remove('hidden');
          if (countDisplay) countDisplay.textContent = `${selectedItems.length} Service${selectedItems.length > 1 ? 's' : ''} Selected`;
          if (totalDisplay) totalDisplay.textContent = `Estimated: ${money(total)} + HST`;
          if (summaryEl) summaryEl.textContent = summary;
          if (itemsEl) {
            itemsEl.innerHTML = selectedItems.map((item) => `
              <div class="booking-package-line">
                <span>${item.serviceName}</span>
                <span>${money(item.lineTotal)}</span>
              </div>
            `).join('');
          }
          if (totalEl) totalEl.textContent = `Estimated total: ${money(total)} + HST`;
          if (summaryInput) summaryInput.value = summary;
          if (totalInput) totalInput.value = String(total);
        }

        function syncServiceButtons() {
          document.querySelectorAll('.toggle-service-btn').forEach((btn) => {
            const serviceName = btn.dataset.service || '';
            const selected = selectedItems.some((item) => item.serviceName === serviceName);
            const textEl = btn.querySelector('.btn-text');
            btn.classList.toggle('selected', selected);
            if (textEl) textEl.textContent = selected ? 'Remove Service' : 'Add to Package';
          });
        }

        document.querySelectorAll('.toggle-service-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const serviceCode = btn.dataset.code || (btn.dataset.service || '').toLowerCase().replace(/[^a-z0-9]+/g, '-');
            const serviceName = btn.dataset.service || 'Service';
            const unitPrice = Number(btn.dataset.price || 0);
            const existingIndex = selectedItems.findIndex((item) => item.serviceCode === serviceCode);
            if (existingIndex >= 0) {
              selectedItems.splice(existingIndex, 1);
            } else {
              selectedItems.push({ serviceCode, serviceName, unitPrice, quantity: 1, lineTotal: unitPrice });
            }
            syncServiceButtons();
            renderSelectedPackage();
          });
        });

        scrollToRequestBtn?.addEventListener('click', () => requestPanel?.scrollIntoView({ behavior: 'smooth', block: 'start' }));
        checkoutBtn?.addEventListener('click', () => requestPanel?.scrollIntoView({ behavior: 'smooth', block: 'start' }));

        // ── Cal.com opener — FIX #2: polls until Cal embed is ready ───────────
        function openCalBooking(data) {
          const calPrefill = data?.calPayload || {};
          function tryOpen(attempts) {
            if (window.Cal && window.Cal.ns && window.Cal.ns['30min']) {
              window.Cal.ns['30min']('modal', {
                calLink: calLink,
                config: { layout: 'month_view', theme: 'dark' },
                ...(calPrefill.name || calPrefill.email
                  ? { responses: { name: calPrefill.name, email: calPrefill.email, notes: calPrefill.notes } }
                  : {})
              });
            } else if (attempts < 15) {
              setTimeout(() => tryOpen(attempts + 1), 300);
            } else {
              window.open(`https://cal.com/${calLink}`, '_blank');
            }
          }
          tryOpen(0);
        }

        // ── Booking form submit — FIX #8 (error scroll + message), FIX #9 (disabled style) ──
        async function createBookingRequestAndOpenCal(event) {
          event.preventDefault();

          // FIX #8: if no services, scroll user back up and show coloured error with link
          if (!selectedItems.length) {
            if (statusEl) {
              statusEl.className = 'is-error';
              statusEl.innerHTML = '&#9888; Please <a href="#services" style="color:var(--accent-soft);text-decoration:underline">select at least one service</a> above first.';
            }
            document.getElementById('services')?.scrollIntoView({ behavior: 'smooth' });
            return;
          }

          const fullName = document.getElementById('client-full-name')?.value?.trim() || '';
          const email = document.getElementById('client-email')?.value?.trim() || '';
          const phone = document.getElementById('client-phone')?.value?.trim() || '';
          const propertyAddress = document.getElementById('property-address')?.value?.trim() || '';
          const notes = document.getElementById('client-notes')?.value?.trim() || '';
          const packageSummary = summaryInput?.value || selectedItems.map((item) => item.serviceName).join(' + ');
          const displayTotal = Number(totalInput?.value || 0);

          if (!fullName || !email) {
            if (statusEl) {
              statusEl.className = 'is-error';
              statusEl.textContent = '&#9888; Full name and email are required.';
            }
            return;
          }

          const payload = {
            fullName, email, phone, propertyAddress, notes, packageSummary, displayTotal,
            selectedServices: selectedItems.map((item) => ({
              service_code: item.serviceCode,
              service_name: item.serviceName,
              unit_price: item.unitPrice,
              quantity: item.quantity || 1
            })),
            source: 'marketing_site'
          };

          try {
            // FIX #9: disable button so user can't double-submit
            if (submitBtn) submitBtn.setAttribute('disabled', 'true');
            if (statusEl) {
              statusEl.className = 'is-loading';
              statusEl.textContent = 'Saving your request\u2026';
            }

            const response = await fetch(`${portalApiBase}/api/public/bookings`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload)
            });

            const data = await response.json();
            if (!response.ok) throw new Error(data.error || 'Could not save booking request');

            if (statusEl) {
              statusEl.className = 'is-success';
              statusEl.textContent = `\u2713 Saved \u2014 Ref: ${data.reference}. Opening calendar\u2026`;
            }
            openCalBooking(data);
          } catch (error) {
            console.error(error);
            if (statusEl) {
              statusEl.className = 'is-error';
              statusEl.textContent = `\u26A0 ${error?.message || 'Something went wrong. Please try again.'}`;
            }
          } finally {
            if (submitBtn) submitBtn.removeAttribute('disabled');
          }
        }

        requestForm?.addEventListener('submit', createBookingRequestAndOpenCal);
        renderSelectedPackage();
      });
    </script>
  </body>
</html>
