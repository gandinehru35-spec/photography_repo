<script type="text/javascript">
  (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.com/embed/embed.js", "init");
Cal("init", "30min", {origin:"https://app.cal.com"});
Cal.config = Cal.config || {};
Cal.config.forwardQueryParams = true;

  Cal.ns["30min"]("inline", {
    elementOrSelector:"#my-cal-inline-30min",
    config: {"layout":"month_view","useSlotsViewOnSmallScreen":"true"},
    calLink: "jarts/30min",
  });

  Cal.ns["30min"]("ui", {"hideEventTypeDetails":false,"layout":"month_view"});
  </script>
  <script>
      document.addEventListener('DOMContentLoaded', () => {

        /* ─── SCROLL REVEAL ─── */
        const revealObs = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('revealed'); revealObs.unobserve(e.target); } });
        }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.reveal-item').forEach((el) => revealObs.observe(el));

        /* ─── NAV ACTIVE HIGHLIGHT ─── */
        const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link[href^="#"]');
        const sectionObs = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              navLinks.forEach((l) => l.classList.toggle('nav-active', l.getAttribute('href') === `#${e.target.id}`));
            }
          });
        }, { threshold: 0.35 });
        document.querySelectorAll('section[id], header[id]').forEach((s) => sectionObs.observe(s));

        /* ─── NAV SCROLL SHADOW ─── */
        const nav = document.getElementById('site-nav');
        window.addEventListener('scroll', () => nav?.classList.toggle('scrolled', window.scrollY > 60), { passive: true });

        /* ─── MOBILE MENU ─── */
        const menuBtn  = document.getElementById('mobile-menu-btn') as HTMLButtonElement;
        const navEl    = document.getElementById('nav-links');
        const overlay  = document.getElementById('mobile-overlay');
        const closeMenu = () => {
          navEl?.classList.remove('open');
          menuBtn?.classList.remove('open');
          menuBtn?.setAttribute('aria-expanded', 'false');
          menuBtn?.setAttribute('aria-label', 'Open navigation menu');
          overlay?.classList.remove('visible');
        };
        menuBtn?.addEventListener('click', () => {
          const open = navEl?.classList.toggle('open');
          menuBtn.classList.toggle('open', open);
          menuBtn.setAttribute('aria-expanded', String(open));
          menuBtn.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
          overlay?.classList.toggle('visible', open);
        });
        overlay?.addEventListener('click', closeMenu);
        navEl?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });

        /* ─── RIPPLE EFFECT ─── */
        document.querySelectorAll<HTMLElement>('.btn-ripple').forEach((btn) => {
          btn.addEventListener('click', function (e) {
            const me = e as MouseEvent;
            const rect = (this as HTMLElement).getBoundingClientRect();
            const rpl = document.createElement('span');
            rpl.className = 'ripple-effect';
            rpl.style.cssText = `left:${me.clientX - rect.left}px;top:${me.clientY - rect.top}px`;
            (this as HTMLElement).appendChild(rpl);
            rpl.addEventListener('animationend', () => rpl.remove());
          });
        });

        /* ─── PROOF TOOLTIPS ─── */
        document.querySelectorAll<HTMLElement>('.proof-item[data-tooltip]').forEach((el) => {
          const tip = document.createElement('div');
          tip.className = 'proof-tooltip';
          tip.textContent = el.dataset.tooltip || '';
          el.style.position = 'relative';
          el.appendChild(tip);
        });

        /* ─── GALLERY FILTER ─── */
        const filterBtns       = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
        const galleryItems     = document.querySelectorAll<HTMLElement>('.gallery-item');
        const loadMoreWrap     = document.getElementById('load-more-container');
        const loadMoreBtn      = document.getElementById('load-more-btn');
        let currentFilter = 'all';

        filterBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            filterBtns.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');
            currentFilter = btn.dataset.filter || 'all';
            galleryItems.forEach((item) => {
              const match = currentFilter === 'all' || item.dataset.category === currentFilter;
              const isExtra = item.classList.contains('extra-image');
              if (match && !isExtra) { item.classList.remove('hidden'); item.style.animation = 'galleryFadeIn 0.35s ease forwards'; }
              else item.classList.add('hidden');
            });
            if (loadMoreWrap) loadMoreWrap.style.display = currentFilter === 'all' ? 'flex' : 'none';
          });
        });

        loadMoreBtn?.addEventListener('click', () => {
          galleryItems.forEach((item) => {
            item.classList.remove('extra-image');
            if (currentFilter === 'all' || item.dataset.category === currentFilter) item.classList.remove('hidden');
          });
          loadMoreWrap?.remove();
        });

        /* ─── LIGHTBOX ─── */
        const lbModal   = document.getElementById('lightbox-modal');
        const lbImg     = document.getElementById('lightbox-image') as HTMLImageElement | null;
        const lbClose   = document.getElementById('lightbox-close');
        const lbPrev    = document.getElementById('lightbox-prev');
        const lbNext    = document.getElementById('lightbox-next');
        const lbCounter = document.getElementById('lightbox-counter');
        let lbIndex = 0;
        let lbImages: string[] = [];

        const getVisible = () =>
          Array.from(document.querySelectorAll<HTMLElement>('.lightbox-trigger:not(.hidden)'))
            .map((el) => el.dataset.highres || '');

        const openLb = (idx: number) => {
          lbImages = getVisible(); lbIndex = idx;
          if (!lbImages[lbIndex] || !lbImg) return;
          lbImg.src = lbImages[lbIndex];
          lbModal?.classList.remove('hidden');
          lbModal?.removeAttribute('aria-hidden');
          document.body.style.overflow = 'hidden';
          updateCounter();
          const multi = lbImages.length > 1;
          if (lbPrev) (lbPrev as HTMLElement).style.display = multi ? 'flex' : 'none';
          if (lbNext) (lbNext as HTMLElement).style.display = multi ? 'flex' : 'none';
        };

        const closeLb = () => {
          lbModal?.classList.add('hidden');
          lbModal?.setAttribute('aria-hidden', 'true');
          if (lbImg) lbImg.src = '';
          document.body.style.overflow = '';
        };

        const navigate = (dir: number) => {
          lbIndex = (lbIndex + dir + lbImages.length) % lbImages.length;
          if (lbImg) { lbImg.style.opacity = '0'; setTimeout(() => { if (lbImg) { lbImg.src = lbImages[lbIndex]; lbImg.style.opacity = '1'; } updateCounter(); }, 140); }
        };

        const updateCounter = () => { if (lbCounter) lbCounter.textContent = `${lbIndex + 1} / ${lbImages.length}`; };

        document.querySelectorAll<HTMLElement>('.lightbox-trigger').forEach((t, i) => {
          t.addEventListener('click', () => openLb(i));
        });
        lbClose?.addEventListener('click', closeLb);
        lbPrev?.addEventListener('click',  () => navigate(-1));
        lbNext?.addEventListener('click',  () => navigate(1));
        lbModal?.addEventListener('click', (e) => { if (e.target === lbModal) closeLb(); });
        document.addEventListener('keydown', (e) => {
          if (lbModal?.classList.contains('hidden')) return;
          if (e.key === 'Escape')      closeLb();
          if (e.key === 'ArrowLeft')   navigate(-1);
          if (e.key === 'ArrowRight')  navigate(1);
        });

        /* ─── PACKAGE BUILDER & CAL.COM INTEGRATION ─── */
        const toggleBtns = document.querySelectorAll('.toggle-service-btn');
        const builderBar = document.getElementById('package-builder-bar');
        const countDisplay = document.querySelector('.package-count');
        const totalDisplay = document.querySelector('.package-total');
        const checkoutBtn = document.getElementById('package-checkout-btn');

        let selectedServices = new Map();

        toggleBtns.forEach(btn => {
          btn.addEventListener('click', function() {
            const service = (this as HTMLElement).dataset.service;
            const price = parseInt((this as HTMLElement).dataset.price || '0');
            const btnText = this.querySelector('.btn-text');

            if (selectedServices.has(service)) {
              selectedServices.delete(service);
              this.classList.remove('selected');
              if (btnText) btnText.textContent = 'Add to Package';
            } else {
              selectedServices.set(service, price);
              this.classList.add('selected');
              if (btnText) btnText.textContent = 'Remove Service';
            }

            updateBuilderBar();
          });
        });

        function updateBuilderBar() {
          let total = 0;
          selectedServices.forEach(price => total += price);
          
          if (selectedServices.size > 0) {
            builderBar?.classList.remove('hidden');
            if (countDisplay) countDisplay.textContent = `${selectedServices.size} Service${selectedServices.size > 1 ? 's' : ''} Selected`;
            if (totalDisplay) totalDisplay.textContent = `Estimated: $${total} + HST`;
          } else {
            builderBar?.classList.add('hidden');
          }
        }

        checkoutBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          
          let notes = "Client has requested the following package:\\n\\n";
          selectedServices.forEach((price, service) => {
            notes += `- ${service} ($${price})\\n`;
          });
          notes += `\\nTotal Estimated: $${Array.from(selectedServices.values()).reduce((a, b) => a + b, 0)} + HST`;

          // Check if Cal.com script has loaded and push the custom payload
          if (window.Cal && window.Cal.ns && window.Cal.ns["30min"]) {
            window.Cal.ns["30min"]("modal", {
              calLink: "jarts-joa3wv/30min",
              config: {
                notes: notes,
                layout: "month_view"
              }
            });
          } else {
            // Fallback just in case the calendar embed fails to load
            window.location.href = "#book";
          }
        });

      });
    </script>
  </body>
</html>