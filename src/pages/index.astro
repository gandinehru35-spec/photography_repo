---
import '../styles/global.css';
import { Image } from 'astro:assets';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/*.{avif,AVIF,webp,WEBP,jpg,JPG,jpeg,JPEG,png,PNG,svg,SVG}',
  { eager: true }
);

const allItems = Object.entries(imageFiles).map(([path, file]) => {
  const img = file.default;
  const filename = path.split('/').pop() || '';

  return {
    image: img,
    filename,
    category: filename.toUpperCase().includes('DJI') ? 'aerial' : 'interior'
  };
});

const heroItem = allItems.find((item) =>
  item.filename.toLowerCase().includes('housefront')
);

const heroBg = heroItem ? heroItem.image : (allItems[0]?.image || '');
const galleryItems = allItems.filter((item) => item.image !== heroBg);
const initialGallery = galleryItems.slice(0, 12);
const extendedGallery = galleryItems.slice(12);

const portalBaseUrl = 'https://jarts-client-portal.aneeqpatelcuts.workers.dev';
const portalLoginUrl = `${portalBaseUrl}/login`;
const portalSignupUrl = `${portalBaseUrl}/signup`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>J Arts 360 View | Premium Real Estate Media</title>
    <meta
      name="description"
      content="Premium real estate photography, drone media, cinematic video, and 3D tours for listings that deserve better presentation."
    />
  </head>

  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <nav class="site-nav">
      <div class="nav-inner">
        <a href="/" class="brand-mark cinematic-brand" aria-label="J Arts 360 View home">
          <span class="brand-emblem" aria-hidden="true">
            <span class="brand-emblem-core">J</span>
            <span class="brand-emblem-shine"></span>
          </span>

          <span class="brand-copy">
            <span class="brand-kicker">Premium Visual Media</span>
            <span class="brand-name-row">
              <span class="brand-name-main">J Arts</span>
              <span class="brand-name-accent">360 View</span>
            </span>
            <span class="brand-tagline">Real Estate Media</span>
          </span>
        </a>

        <div class="nav-links">
          <a href="#services">Services</a>
          <a href="#portfolio">Portfolio</a>
          <a href="#testimonials">Reviews</a>
          <a href={portalLoginUrl} target="_blank" rel="noopener noreferrer">Client Login</a>
          <a href="#book" class="nav-cta">Book Now</a>
        </div>
      </div>
    </nav>

    <main id="main-content">
      <header class="hero">
        {heroBg ? (
          <Image
            src={heroBg}
            alt="Featured J Arts 360 View property media"
            class="hero-bg"
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <div class="hero-bg hero-fallback"></div>
        )}

        <div class="hero-overlay"></div>

        <div class="hero-content">
          <p class="eyebrow">Premium Real Estate Media</p>
          <h1>Precision visual assets engineered for MLS dominance.</h1>
          <p class="hero-copy">
            Premium real estate photography, cinematic walkthroughs, drone coverage,
            and immersive 3D experiences designed to make listings feel stronger,
            cleaner, and more valuable from the very first click.
          </p>

          <div class="hero-actions">
            <a href="#book" class="primary-btn">Book a Shoot</a>
            <a href={portalLoginUrl} target="_blank" rel="noopener noreferrer" class="secondary-btn">
              Client Login
            </a>
          </div>
        </div>
      </header>

      <section id="services" class="section-pad">
        <div class="section-shell">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Services</p>
              <h2 class="section-title">Media packages built for stronger listings.</h2>
            </div>
            <p class="section-copy section-heading-copy">
              Clean composition, polished edits, and high-impact visuals for agents,
              developers, and property owners who want presentation to feel premium.
            </p>
          </div>

          <div class="services-grid">
            <article class="service-card">
              <h3>Listing Photography</h3>
              <p>
                Optically perfected interior and exterior captures calibrated for
                absolute clarity.
              </p>
              <p class="service-price">From $120 <span>+ HST</span></p>
            </article>

            <article class="service-card">
              <h3>Cinematic Video</h3>
              <p>
                Fluid, story-driven architectural walkthroughs stabilizing spatial flow.
              </p>
              <p class="service-price">From $150 <span>+ HST</span></p>
            </article>

            <article class="service-card">
              <h3>Drone Aerial</h3>
              <p>
                Elevated perspectives securing topographical and neighborhood context.
              </p>
              <p class="service-price">From $99 <span>+ HST</span></p>
            </article>

            <article class="service-card">
              <h3>3D Virtual Tours</h3>
              <p>
                Fully immersive spatial twins allowing unrestricted global access 24/7.
              </p>
              <p class="service-price">From $200 <span>+ HST</span></p>
            </article>
          </div>
        </div>
      </section>

      <section id="portfolio" class="section-pad portfolio-section">
        <div class="section-shell">
          <div class="section-heading portfolio-head">
            <div>
              <p class="eyebrow">Portfolio</p>
              <h2 class="section-title">Selected property visuals.</h2>
            </div>

            <div class="filter-row" id="filter-controls">
              <button class="filter-btn active" data-filter="all" type="button">All</button>
              <button class="filter-btn" data-filter="interior" type="button">Interiors</button>
              <button class="filter-btn" data-filter="aerial" type="button">Aerials</button>
            </div>
          </div>

          <div class="gallery-grid" id="gallery-grid">
            {initialGallery.map((item) => (
              <button
                class="gallery-item lightbox-trigger"
                data-category={item.category}
                data-highres={item.image.src}
                aria-label={`Open ${item.category} image`}
                type="button"
              >
                <Image
                  src={item.image}
                  alt={`J Arts 360 View ${item.category} gallery work`}
                  class="gallery-image"
                  loading="lazy"
                />
              </button>
            ))}

            {extendedGallery.map((item) => (
              <button
                class="gallery-item lightbox-trigger extra-image hidden"
                data-category={item.category}
                data-highres={item.image.src}
                aria-label={`Open ${item.category} image`}
                type="button"
              >
                <Image
                  src={item.image}
                  alt={`J Arts 360 View ${item.category} gallery work`}
                  class="gallery-image"
                  loading="lazy"
                />
              </button>
            ))}
          </div>

          {extendedGallery.length > 0 && (
            <div class="load-more-wrap" id="load-more-container">
              <button id="load-more-btn" class="secondary-btn" type="button">
                Load More
              </button>
            </div>
          )}
        </div>
      </section>

      <section id="testimonials" class="section-pad">
        <div class="section-shell">
          <div class="section-heading">
            <div>
              <p class="eyebrow">Client Reviews</p>
              <h2 class="section-title">Trusted by clients who value presentation.</h2>
            </div>
          </div>

          <div class="reviews-grid">
            <article class="quote-card">
              <p>“Beautifully clicked the pictures. Professional, prompt & friendly service.”</p>
              <strong>Monika Bansal</strong>
            </article>

            <article class="quote-card">
              <p>
                “Photos they produced were absolutely stunning... Commitment to customer
                satisfaction is truly impressive. Highly recommend!”
              </p>
              <strong>Sushaant Dhamijaa</strong>
            </article>

            <article class="quote-card">
              <p>
                “Consistently delivers outstanding results. Communication about schedules
                is key for us—highly recommended!”
              </p>
              <strong>Benson Crew</strong>
            </article>
          </div>
        </div>
      </section>

      <section id="book" class="section-pad booking-section">
        <div class="section-shell booking-layout">
          <div>
            <p class="eyebrow">Book a Shoot</p>
            <h2 class="section-title">Ready to elevate your next listing?</h2>
            <p class="section-copy booking-copy">
              Select your visual package below. Calendar availability is strictly enforced.
              For returning clients, use the portal to log in, manage bookings, and access
              future order history.
            </p>

            <div class="booking-actions portal-actions">
              <a href="tel:6477103982" class="primary-btn">Call Now</a>
              <a href="mailto:jartsguelph@gmail.com" class="secondary-btn">Email Us</a>
              <a href={portalLoginUrl} target="_blank" rel="noopener noreferrer" class="secondary-btn">
                Client Login
              </a>
              <a href={portalSignupUrl} target="_blank" rel="noopener noreferrer" class="secondary-btn">
                Portal Signup
              </a>
            </div>

            <div class="contact-stack">
              <div class="contact-item">
                <span>T</span>
                <a href="tel:6477103982">647 710 3982</a>
              </div>

              <div class="contact-item">
                <span>E</span>
                <a href="mailto:jartsguelph@gmail.com">jartsguelph@gmail.com</a>
              </div>

              <div class="contact-item">
                <span>HQ</span>
                <span>63 Candlewood Drive, Guelph</span>
              </div>
            </div>
          </div>

          <div class="booking-panel">
            <div class="booking-placeholder">
              <h3>Booking calendar launching shortly</h3>
              <p>
                For immediate inquiries, call or email directly, or use the client portal
                to create an account and access booking tools.
              </p>
              <div class="booking-actions">
                <a href={portalLoginUrl} target="_blank" rel="noopener noreferrer" class="primary-btn">
                  Go to Client Portal
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="section-shell footer-inner">
        <div class="footer-brand-block">
          <div class="footer-emblem" aria-hidden="true">J</div>
          <div>
            <p class="footer-brand">J Arts 360 View</p>
            <p class="footer-copy">
              Premium real estate visual storytelling for listings that need better presentation.
            </p>
          </div>
        </div>

        <div class="footer-links">
          <a href="#services">Services</a>
          <a href="#portfolio">Portfolio</a>
          <a href="#book">Contact</a>
          <a href={portalLoginUrl} target="_blank" rel="noopener noreferrer">Client Portal</a>
        </div>
      </div>
    </footer>

    <div id="lightbox-modal" class="lightbox-modal hidden" aria-hidden="true">
      <button
        id="lightbox-close"
        class="lightbox-close"
        aria-label="Close image viewer"
        type="button"
      >
        ✕
      </button>
      <img
        id="lightbox-image"
        src=""
        alt="Expanded gallery image"
        class="lightbox-image"
      />
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const filterBtns = document.querySelectorAll('.filter-btn');
        const galleryItems = document.querySelectorAll('.gallery-item');
        const loadMoreContainer = document.getElementById('load-more-container');
        const loadMoreBtn = document.getElementById('load-more-btn');

        let currentFilter = 'all';

        filterBtns.forEach((btn) => {
          btn.addEventListener('click', (e) => {
            filterBtns.forEach((b) => b.classList.remove('active'));

            const target = e.currentTarget;
            target.classList.add('active');
            currentFilter = target.getAttribute('data-filter') || 'all';

            galleryItems.forEach((item) => {
              const itemCategory = item.getAttribute('data-category');
              const isExtra = item.classList.contains('extra-image');
              const shouldShow = currentFilter === 'all' || currentFilter === itemCategory;

              if (shouldShow && !isExtra) {
                item.classList.remove('hidden');
              } else {
                item.classList.add('hidden');
              }
            });

            if (loadMoreContainer) {
              loadMoreContainer.style.display = currentFilter === 'all' ? 'flex' : 'none';
            }
          });
        });

        if (loadMoreBtn) {
          loadMoreBtn.addEventListener('click', () => {
            galleryItems.forEach((item) => {
              const itemCategory = item.getAttribute('data-category');
              item.classList.remove('extra-image');

              if (currentFilter === 'all' || currentFilter === itemCategory) {
                item.classList.remove('hidden');
              }
            });

            if (loadMoreContainer) {
              loadMoreContainer.remove();
            }
          });
        }

        const modal = document.getElementById('lightbox-modal');
        const modalImage = document.getElementById('lightbox-image');
        const closeBtn = document.getElementById('lightbox-close');
        const triggers = document.querySelectorAll('.lightbox-trigger');

        const closeModal = () => {
          modal?.classList.add('hidden');
          if (modalImage) modalImage.setAttribute('src', '');
          document.body.style.overflow = 'auto';
        };

        triggers.forEach((trigger) => {
          trigger.addEventListener('click', () => {
            const highResSource = trigger.getAttribute('data-highres');

            if (modalImage && highResSource) {
              modalImage.setAttribute('src', highResSource);
            }

            modal?.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
          });
        });

        closeBtn?.addEventListener('click', closeModal);

        modal?.addEventListener('click', (e) => {
          if (e.target === modal) {
            closeModal();
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closeModal();
          }
        });
      });
    </script>
  </body>
</html>